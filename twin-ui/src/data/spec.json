{
  "components": {
    "MiniStation": {
      "type": "station",
      "spec": {"purpose": "test", "future_field": {"enabled": true}}
    },
    "EnergySystem": {
      "type": "system",
      "spec": {"subsystem": "energy"}
    },
    "Generator": {
      "type": "generator",
      "spec": {
        "rating": {"value": 10, "unit": "kW"},
        "fuel_capacity": {"value": 100, "unit": "L"},
        "fuel_rate": 0.25
      }
    },
    "FuelSensor": {
      "type": "sensor",
      "spec": {
        "quantity": "fuel_level",
        "accuracy": 0.5,
        "rating": {"min": 0, "max": 100, "unit": "%"},
        "resolution": 0.1
      }
    },
    "Controller": {
      "type": "controller",
      "spec": {
        "inputs": ["power_data", "fuel_data"],
        "outputs": ["command"]
      }
    }
  },
  "defaults": {}
}