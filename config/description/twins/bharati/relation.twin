# ============================================================

# BHARATI ANTARCTIC RESEARCH STATION

# ============================================================

Bharati:station %critical %essential %research {

    # --------------------------------------------------------
    # POWER AND MICROGRID BLOCK
    # --------------------------------------------------------

    PowerBlock:block %critical %essential {

        MicrogridSystem:system %power %autonomous %critical {

            SolarArray:solar %renewable %primary
            DieselGeneratorA:generator %primary %backup
            DieselGeneratorB:generator %backup

            BatteryStorage:battery %storage %critical
            PowerConditioner:inverter %critical

            GridVoltageSensor:sensor %monitoring %critical
            FuelSensor:sensor %monitoring
            BatteryHealthSensor:sensor %monitoring

            MicrogridController:controller %automatic %critical
        }
    }

    # --------------------------------------------------------
    # HABITATION AND LIFE SUPPORT BLOCK
    # --------------------------------------------------------

    HabitatBlock:block %essential %personnel {

        LifeSupportSystem:system %habitation %critical {

            HeatingUnit:heater %primary
            AirCirculationUnit:fan %essential
            FreshAirUnit:ventilator %essential

            IndoorTempSensor:sensor %monitoring
            HumiditySensor:sensor %monitoring
            CO2Sensor:sensor %monitoring %critical

            LifeSupportController:controller %automatic %critical
        }

        AccommodationSystem:system %personnel {

            SleepingModule:habitat %personnel
            RecreationModule:habitat %personnel
            MedicalModule:medical %safety

            OccupancySensor:sensor %monitoring
            MedicalMonitor:sensor %health

            HabitatController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # EARTH SCIENCE BLOCK
    # --------------------------------------------------------

    EarthScienceBlock:block %research %science {

        GeoscienceSystem:system %geology %research {

            SeismicStation:seismic %monitoring %critical
            GPSReceiver:receiver %geospatial
            GroundMovementSensor:sensor %monitoring

            SeismicDataLogger:logger %data
            GeoscienceController:controller %automatic
        }

        AtmosphericSystem:system %atmospheric %science {

            WeatherStation:weather %monitoring
            WindSensor:sensor %monitoring
            PressureSensor:sensor %monitoring
            RadiationSensor:sensor %monitoring %critical

            AtmosphericLogger:logger %data
            AtmosphereController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # OCEAN AND COASTAL RESEARCH BLOCK
    # --------------------------------------------------------

    CoastalResearchBlock:block %research %science {

        MarineSystem:system %marine %field {

            OceanProbe:probe %primary
            WaterSampler:sampler %research
            SalinitySensor:sensor %monitoring
            OceanTemperatureSensor:sensor %monitoring

            MarineDataLogger:logger %data
            MarineController:controller %automatic
        }

        FieldOperationsSystem:system %mobile %research {

            FieldVehicle:vehicle %primary %mobile
            SurveyDrone:drone %mobile

            NavigationUnit:navigation %critical
            FieldGPS:sensor %geospatial

            FieldOperationsController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # COMMUNICATIONS AND DATA BLOCK
    # --------------------------------------------------------

    CommunicationsBlock:block %network %critical {

        SatelliteCommunicationSystem:system %satellite %essential {

            SatelliteTerminal:terminal %primary %critical
            HighGainAntenna:antenna %primary
            BackupAntenna:antenna %backup

            LinkQualitySensor:sensor %monitoring
            SatelliteModem:modem %critical

            CommunicationsController:controller %automatic %critical
        }

        DataManagementSystem:system %data %research {

            ResearchDataServer:server %primary
            ArchiveServer:server %backup
            DataStorage:storage %critical

            DataIntegritySensor:sensor %monitoring
            DataManagementController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # LOGISTICS AND SUPPLY BLOCK
    # --------------------------------------------------------

    LogisticsBlock:block %essential %mobile {

        SupplySystem:system %logistics %critical {

            CargoInventory:storage %inventory
            FuelDepot:storage %fuel %critical
            EquipmentDepot:storage %equipment

            InventorySensor:sensor %monitoring
            FuelDepotSensor:sensor %monitoring %critical

            SupplyController:controller %automatic
        }

        TransportSystem:system %transport %mobile {

            CargoTransport:vehicle %primary
            UtilityVehicle:vehicle %backup
            Snowmobile:vehicle %field

            VehicleTracker:tracker %monitoring
            TransportController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # WATER AND ENVIRONMENT BLOCK
    # --------------------------------------------------------

    EnvironmentBlock:block %essential %environment {

        WaterTreatmentSystem:system %water %critical {

            MeltwaterTank:tank %storage
            TreatmentUnit:treatment %primary
            WaterPump:pump %primary

            WaterLevelSensor:sensor %monitoring
            WaterQualitySensor:sensor %monitoring %critical

            WaterTreatmentController:controller %automatic
        }

        WasteManagementSystem:system %waste %environment {

            WasteProcessor:processor %primary
            WasteStorage:storage %critical

            WasteLevelSensor:sensor %monitoring
            WasteMonitor:sensor %environment

            WasteManagementController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # SAFETY AND EMERGENCY BLOCK
    # --------------------------------------------------------

    SafetyBlock:block %safety %critical {

        EmergencySystem:system %emergency %critical {

            EmergencyBeacon:beacon %critical
            EmergencyRadio:radio %critical
            EmergencyLocator:locator %critical

            EmergencySensor:sensor %monitoring
            EmergencyController:controller %automatic %safety
        }

        FireProtectionSystem:system %fire_safety %critical {

            FireDetector:detector %monitoring
            SmokeDetector:detector %monitoring
            FireSuppressionUnit:suppression %critical

            FireSafetyController:controller %automatic %safety
        }
    }
}

# ============================================================

# RELATIONSHIPS

# ============================================================

# -------------------- POWER -------------------------------

SolarArray-->PowerConditioner@power_generation
DieselGeneratorA-->MicrogridController@generation_status
DieselGeneratorB-->MicrogridController@generation_status

GridVoltageSensor-->MicrogridController@voltage
FuelSensor-->MicrogridController@fuel_level
BatteryHealthSensor-->MicrogridController@battery_health

MicrogridController-->DieselGeneratorA@start_stop
MicrogridController-->DieselGeneratorB@backup_control

MicrogridController-->BatteryStorage@charge_discharge
BatteryStorage-->PowerConditioner@stored_energy
PowerConditioner-->LifeSupportController@power_supply

# -------------------- HABITATION --------------------------

IndoorTempSensor-->LifeSupportController@temperature
HumiditySensor-->LifeSupportController@humidity
CO2Sensor-->LifeSupportController@air_quality

LifeSupportController-->HeatingUnit@heat_control
LifeSupportController-->AirCirculationUnit@airflow
LifeSupportController-->FreshAirUnit@ventilation

OccupancySensor-->HabitatController@occupancy
MedicalMonitor-->HabitatController@medical_status

HabitatController-->LifeSupportController@habitat_demand
HabitatController-->EmergencyController@personnel_status

# -------------------- EARTH SCIENCE -----------------------

SeismicStation-->SeismicDataLogger@seismic_activity
GPSReceiver-->SeismicDataLogger@position
GroundMovementSensor-->GeoscienceController@ground_motion

SeismicDataLogger-->GeoscienceController@seismic_data
GeoscienceController-->ResearchDataServer@geoscience_data

WeatherStation-->AtmosphericLogger@weather_data
WindSensor-->AtmosphereController@wind_speed
PressureSensor-->AtmosphereController@pressure
RadiationSensor-->AtmosphereController@radiation

AtmosphericLogger-->AtmosphereController@atmospheric_data
AtmosphereController-->ResearchDataServer@weather_records

# -------------------- MARINE RESEARCH ---------------------

OceanProbe-->MarineDataLogger@ocean_measurements
WaterSampler-->MarineController@sample_status
SalinitySensor-->MarineController@salinity
OceanTemperatureSensor-->MarineController@temperature

MarineDataLogger-->MarineController@marine_data
MarineController-->ResearchDataServer@ocean_records

FieldGPS-->FieldOperationsController@location
NavigationUnit-->FieldOperationsController@navigation
FieldOperationsController-->FieldVehicle@vehicle_control
FieldOperationsController-->SurveyDrone@mission_control

SurveyDrone-->FieldOperationsController@survey_data
FieldVehicle-->FieldOperationsController@vehicle_status

FieldOperationsController-->MarineController@field_mission

# -------------------- COMMUNICATIONS ----------------------

SatelliteTerminal-->SatelliteModem@satellite_connection
HighGainAntenna-->SatelliteTerminal@primary_link
BackupAntenna-->SatelliteTerminal@backup_link

LinkQualitySensor-->CommunicationsController@signal_quality
SatelliteModem-->CommunicationsController@link_status

CommunicationsController-->SatelliteTerminal@connection_control
CommunicationsController-->ResearchDataServer@remote_access

ResearchDataServer-->DataManagementController@research_data
ArchiveServer-->DataManagementController@backup_data
DataIntegritySensor-->DataManagementController@integrity_status

DataManagementController-->DataStorage@archive
DataManagementController-->ArchiveServer@replication

# -------------------- LOGISTICS ---------------------------

InventorySensor-->SupplyController@inventory_status
FuelDepotSensor-->SupplyController@fuel_status

SupplyController-->CargoInventory@inventory_update
SupplyController-->FuelDepot@fuel_management
SupplyController-->EquipmentDepot@equipment_tracking

VehicleTracker-->TransportController@vehicle_location

TransportController-->CargoTransport@dispatch
TransportController-->UtilityVehicle@dispatch
TransportController-->Snowmobile@field_dispatch

CargoTransport-->SupplyController@delivery_status
UtilityVehicle-->SupplyController@utility_status
Snowmobile-->FieldOperationsController@field_location

# -------------------- WATER -------------------------------

WaterLevelSensor-->WaterTreatmentController@water_level
WaterQualitySensor-->WaterTreatmentController@water_quality

WaterTreatmentController-->WaterPump@pump_control
WaterPump-->TreatmentUnit@water_flow
TreatmentUnit-->MeltwaterTank@treated_water

WaterTreatmentController-->LifeSupportController@water_status
WaterTreatmentController-->ResearchDataServer@water_quality_data

# -------------------- WASTE -------------------------------

WasteLevelSensor-->WasteManagementController@storage_level
WasteMonitor-->WasteManagementController@environmental_status

WasteManagementController-->WasteProcessor@processing_control
WasteProcessor-->WasteStorage@processed_waste

WasteManagementController-->ResearchDataServer@environment_data
WasteManagementController-->SupplyController@waste_logistics

# -------------------- SAFETY ------------------------------

EmergencySensor-->EmergencyController@emergency_detection

EmergencyController-->EmergencyBeacon@activate
EmergencyController-->EmergencyRadio@broadcast
EmergencyController-->EmergencyLocator@location_signal

EmergencyController-->CommunicationsController@emergency_message
CommunicationsController-->EmergencyController@remote_contact

FireDetector-->FireSafetyController@fire_detection
SmokeDetector-->FireSafetyController@smoke_detection

FireSafetyController-->FireSuppressionUnit@suppression_control
FireSafetyController-->EmergencyController@fire_alert

# -------------------- CROSS-SYSTEM RESEARCH --------------

GeoscienceController-->DataManagementController@research_stream
AtmosphereController-->DataManagementController@research_stream
MarineController-->DataManagementController@research_stream

DataManagementController-->CommunicationsController@data_transmission

CommunicationsController-->ResearchDataServer@remote_commands

# -------------------- CENTRAL STATION CONTROL ------------

MicrogridController-->EmergencyController@power_emergency
LifeSupportController-->EmergencyController@life_support_alert

SupplyController-->HabitatController@supply_status
TransportController-->SupplyController@transport_status

EmergencyController-->MicrogridController@emergency_power_command
EmergencyController-->LifeSupportController@emergency_mode

DataManagementController-->EmergencyController@system_health

ResearchDataServer-->CommunicationsController@station_data
