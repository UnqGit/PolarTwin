# ============================================================
# TYPE DEFAULTS
# ============================================================
# ------------------------------------------------------------
# STATION
# ------------------------------------------------------------

default:station {
    provides="research station"
    environment="Antarctic"
    mounting=ground
    representation=building
}

# ------------------------------------------------------------
# BLOCK
# ------------------------------------------------------------

default:block {
    provides="functional station block"
    mounting=indoor
    representation=room
}

# ------------------------------------------------------------
# SYSTEM
# ------------------------------------------------------------

default:system {
    provides="functional system"
    mounting=floor
    representation=equipment_group
}

# ------------------------------------------------------------
# SOLAR ARRAY
# ------------------------------------------------------------

default:solar {
    provides="renewable electrical power"
    output="electrical"
    energy_source="solar"
    representation=solar_array
}

# ------------------------------------------------------------
# GENERATOR
# ------------------------------------------------------------

default:generator {
    provides="electrical power"
    output="electrical"
    fuel="diesel"
    frequency=50 unit=Hz
    voltage=400 unit=V
    phases=3
    representation=generator
}

# ------------------------------------------------------------
# BATTERY
# ------------------------------------------------------------

default:battery {
    provides="electrical energy storage"
    output="DC"
    technology="lithium battery"
    representation=battery
}

# ------------------------------------------------------------
