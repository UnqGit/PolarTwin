# ============================================================
# BHARATI ANTARCTIC RESEARCH STATION
# ============================================================

#
# Logical model inspired by the Indian Bharati research station
# at Larsemann Hills, Antarctica.
#

# ------------------------------------------------------------
# Main building:
# Level 0 -> Operations, laboratories, workshops and utilities
# Level 1 -> Living, administration and medical facilities
# Level 2 -> Technical systems, communications and computing
#
# External infrastructure:
# Fuel farm
# Sea-water intake / pump house
# Emergency shelter / summer camp
# Field science modules
# ============================================================

Bharati:station %critical %essential %antarctic {

    # --------------------------------------------------------
    # MAIN BUILDING
    # --------------------------------------------------------

    MainBuilding:block %primary %critical %elevated {

        # ----------------------------------------------------
        # LEVEL 0
        # Operations, laboratories and utilities
        # ----------------------------------------------------

        OperationsFloor:floor @level=0 %operations %critical {

            # ------------------------------------------------
            # SCIENTIFIC LABORATORY SYSTEM
            # ------------------------------------------------

            LaboratorySystem:system %science %critical {

                AtmosphericLab:laboratory %atmospheric %science
                GeologyLab:laboratory %geology %science
                BiologyLab:laboratory %biology %science
                OceanScienceLab:laboratory %ocean %science
                EnvironmentalLab:laboratory %environment %science

                LabTemperatureSensor:sensor %monitoring
                LabHumiditySensor:sensor %monitoring
                LabAirQualitySensor:sensor %monitoring %critical
                LabPowerSensor:sensor %monitoring

                LaboratoryController:controller %automatic %science
            }

            # ------------------------------------------------
            # WORKSHOP SYSTEM
            # ------------------------------------------------

            WorkshopSystem:system %maintenance %essential {

                MechanicalWorkshop:workshop %mechanical
                ElectricalWorkshop:workshop %electrical
                InstrumentWorkshop:workshop %scientific

                WorkshopPowerSensor:sensor %monitoring
                WorkshopTemperatureSensor:sensor %monitoring

                WorkshopController:controller %automatic
            }

            # ------------------------------------------------
            # STORAGE SYSTEM
            # ------------------------------------------------

            GroundStorageSystem:system %storage %critical {

                EquipmentStore:storage %equipment
                ScientificStore:storage %science
                SparePartsStore:storage %maintenance
                ColdStore:storage %cold_storage %critical

                StorageTemperatureSensor:sensor %monitoring %critical
                StorageHumiditySensor:sensor %monitoring

                StorageController:controller %automatic
            }

            # ------------------------------------------------
            # GROUND LEVEL UTILITY SYSTEM
            # ------------------------------------------------

            UtilityRoomSystem:system %utility %critical {

                MainElectricalRoom:electrical_room %power
                PumpRoom:pump_room %water
                WasteTreatmentRoom:treatment_room %waste
                TechnicalWorkshop:workshop %maintenance

                UtilityTemperatureSensor:sensor %monitoring
                UtilitySmokeSensor:sensor %fire %critical

                UtilityController:controller %automatic %critical
            }
        }

        # ----------------------------------------------------
        # LEVEL 1
        # Living, administration and human support
        # ----------------------------------------------------

        LivingFloor:floor @level=1 %living %essential {

            # ------------------------------------------------
            # RESIDENTIAL SYSTEM
            # ------------------------------------------------

            ResidentialSystem:system %living %essential {

                ScientistQuarters:accommodation %personnel
                EngineerQuarters:accommodation %personnel
                MedicalQuarters:accommodation %medical
                CommonRoom:lounge %recreation
                Library:library %research %recreation

                RoomTemperatureSensor:sensor %monitoring
                RoomAirQualitySensor:sensor %monitoring

                ResidentialController:controller %automatic
            }

            # ------------------------------------------------
            # DINING AND FOOD SYSTEM
            # ------------------------------------------------

            FoodServiceSystem:system %food %essential {

                Kitchen:kitchen %essential
                DiningHall:dining %essential
                FoodPreparationRoom:food_room %essential
                FoodColdStorage:storage %cold_storage %critical

                FoodTemperatureSensor:sensor %monitoring %critical
                KitchenAirQualitySensor:sensor %monitoring

                FoodServiceController:controller %automatic
            }

            # ------------------------------------------------
            # MEDICAL SYSTEM
            # ------------------------------------------------

            MedicalSystem:system %medical %critical {

                MedicalRoom:medical_room %critical
                FirstAidRoom:medical_room %emergency
                HypothermiaTreatmentRoom:treatment_room %emergency

                MedicalTemperatureSensor:sensor %monitoring
                MedicalAirQualitySensor:sensor %monitoring

                MedicalController:controller %automatic %critical
            }

            # ------------------------------------------------
            # ADMINISTRATION SYSTEM
            # ------------------------------------------------

            AdministrationSystem:system %administration {

                StationOffice:office %administration
                ExpeditionOffice:office %logistics
                ConferenceRoom:conference %administration
                RecordsRoom:archive %data

                PersonnelDatabase:database %critical
                PersonnelServer:server %primary %critical

                AdministrationController:controller %automatic
            }

            # ------------------------------------------------
            # SANITATION AND PERSONAL SERVICES
            # ------------------------------------------------

            PersonalServicesSystem:system %essential {

                Washrooms:sanitation %essential
                Sauna:sauna %wellbeing
                LaundryRoom:laundry %essential

                WaterConsumptionSensor:sensor %monitoring
                HotWaterSensor:sensor %monitoring

                PersonalServicesController:controller %automatic
            }
        }

        # ----------------------------------------------------
        # LEVEL 2
        # Technical, communications and computing
        # ----------------------------------------------------

        TechnicalFloor:floor @level=2 %technical %critical {

            # ------------------------------------------------
            # STATION CONTROL SYSTEM
            # ------------------------------------------------

            StationControlSystem:system %central %critical {

                MainController:controller %primary %central %critical
                BackupController:controller %backup %critical

                ControlServer:server %primary %critical
                BackupServer:server %backup

                StationHealthSensor:sensor %monitoring %critical
                NetworkHealthSensor:sensor %monitoring

                ControlConsole:console %operations
            }

            # ------------------------------------------------
            # DATA AND COMPUTING SYSTEM
            # ------------------------------------------------

            DataSystem:system %data %science %critical {

                ResearchDataServer:server %research %critical
                ScienceDatabase:database %research %critical
                BackupDatabase:database %backup

                DataStorage:storage %digital %critical
                DataProcessingCluster:computer_cluster %research

                DataTemperatureSensor:sensor %monitoring
                DataPowerSensor:sensor %monitoring

                DataController:controller %automatic
            }

            # ------------------------------------------------
            # COMMUNICATION SYSTEM
            # ------------------------------------------------

            CommunicationSystem:system %network %critical {

                MainRouter:router %primary %critical
                BackupRouter:router %backup

                SatelliteTerminal:satellite_terminal %primary %critical
                SatelliteAntenna:antenna %primary %critical

                RadioTerminal:radio %backup %emergency
                HFTransceiver:radio %emergency
                VHFTransceiver:radio %field

                CommunicationServer:server %critical
                CommunicationController:controller %automatic
            }

            # ------------------------------------------------
            # EARTH STATION / REMOTE SENSING SYSTEM
            # ------------------------------------------------

            EarthStationSystem:system %satellite %science %critical {

                SatelliteTrackingUnit:tracking_unit %remote_sensing
                SatelliteDataReceiver:data_receiver %science
                SatelliteCommandTerminal:terminal %science
                RemoteSensingServer:server %science %critical

                EarthStationSensor:sensor %monitoring
                SignalStrengthSensor:sensor %monitoring

                EarthStationController:controller %automatic
            }

            # ------------------------------------------------
            # HVAC SYSTEM
            # ------------------------------------------------

            HVACSystem:system %thermal %critical {

                HeatingUnit:heater %primary %critical
                BackupHeatingUnit:heater %backup %critical

                AirHandlingUnit:air_handler %primary
                VentilationFan:fan %primary
                ExhaustFan:fan %backup

                IndoorTemperatureSensor:sensor %monitoring %critical
                OutdoorTemperatureSensor:sensor %monitoring
                AirPressureSensor:sensor %monitoring
                AirQualitySensor:sensor %monitoring %critical

                HVACController:controller %automatic %critical
            }
        }
    }

    # --------------------------------------------------------
    # ENERGY BLOCK
    # --------------------------------------------------------

    EnergyBlock:block %critical %essential {

        PowerGenerationSystem:system %power %critical {

            CHPUnit1:chp %primary %critical
            CHPUnit2:chp %backup %critical
            CHPUnit3:chp %redundant %critical

            MainGeneratorController:controller %central %automatic

            Generator1Sensor:sensor %monitoring
            Generator2Sensor:sensor %monitoring
            Generator3Sensor:sensor %monitoring

            FuelConsumptionSensor:sensor %monitoring
            PowerOutputSensor:sensor %monitoring %critical
        }

        PowerDistributionSystem:system %power_distribution %critical {

            MainSwitchboard:switchboard %primary %critical
            EmergencySwitchboard:switchboard %backup %critical

            Transformer:transformer %primary
            UPS:ups %critical
            BatteryBank:battery %backup %critical
            PowerInverter:inverter %critical

            DistributionSensor:sensor %monitoring
            BatterySensor:sensor %monitoring

            PowerController:controller %automatic %critical
        }
    }

    # --------------------------------------------------------
    # FUEL INFRASTRUCTURE
    # --------------------------------------------------------

    FuelBlock:block %fuel %critical %external {

        FuelFarm:system %fuel_storage %critical {

            MainFuelTank:tank %primary %critical
            BackupFuelTank:tank %backup %critical
            FuelTransferPump:pump %fuel %critical

            FuelLevelSensor:sensor %monitoring %critical
            FuelPressureSensor:sensor %monitoring
            FuelLeakSensor:sensor %safety %critical

            FuelFarmController:controller %automatic %critical
        }

        FuelStation:system %fuel_transfer %essential {

            FuelDispenser:dispenser %fuel
            FuelTransferLine:pipeline %fuel
            FuelMeter:sensor %monitoring

            FuelStationController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # WATER AND SEAWATER BLOCK
    # --------------------------------------------------------

    WaterBlock:block %water %essential %critical {

        SeaWaterSystem:system %water %essential {

            SeaWaterIntake:intake %marine %critical
            SeaWaterPump:pump %primary %critical
            SeaWaterBackupPump:pump %backup

            IntakePressureSensor:sensor %monitoring
            IntakeFlowSensor:sensor %monitoring

            SeaWaterController:controller %automatic
        }

        WaterTreatmentSystem:system %water_treatment %critical {

            DesalinationUnit:treatment_unit %primary %critical
            FreshWaterTank:tank %storage %critical
            HotWaterTank:tank %hot_water

            WaterQualitySensor:sensor %monitoring %critical
            WaterLevelSensor:sensor %monitoring %critical
            WaterTemperatureSensor:sensor %monitoring

            WaterTreatmentController:controller %automatic %critical
        }

        WaterDistributionSystem:system %water_distribution %essential {

            MainWaterPump:pump %primary
            BackupWaterPump:pump %backup

            FreshWaterPipeline:pipeline %water
            HotWaterPipeline:pipeline %water

            WaterPressureSensor:sensor %monitoring
            WaterFlowSensor:sensor %monitoring

            WaterDistributionController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # WASTE MANAGEMENT BLOCK
    # --------------------------------------------------------

    WasteBlock:block %waste %essential %critical {

        WasteWaterSystem:system %wastewater %critical {

            WasteWaterCollection:treatment_unit %wastewater
            WasteWaterTreatment:treatment_unit %primary %critical
            TreatedWaterTank:tank %storage

            WasteWaterLevelSensor:sensor %monitoring
            WasteWaterQualitySensor:sensor %monitoring %critical

            WasteWaterController:controller %automatic
        }

        SolidWasteSystem:system %solid_waste %essential {

            WasteCollection:storage %waste
            WasteProcessingUnit:treatment_unit %waste
            WasteStorage:storage %waste

            WasteLevelSensor:sensor %monitoring
            WasteProcessingSensor:sensor %monitoring

            WasteController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # LOGISTICS BLOCK
    # --------------------------------------------------------

    LogisticsBlock:block %logistics %essential {

        CargoSystem:system %logistics %critical {

            CargoStorage:storage %cargo
            EquipmentCargoStore:storage %equipment
            ExpeditionSupplyStore:storage %supplies

            CargoInventorySensor:sensor %monitoring
            CargoTemperatureSensor:sensor %monitoring

            CargoController:controller %automatic
        }

        FieldLogisticsSystem:system %field %mobile {

            SnowVehicle:vehicle %primary %mobile
            UtilityVehicle:vehicle %backup %mobile
            FieldTrailer:trailer %logistics

            VehicleGPS:sensor %monitoring
            VehicleTelemetry:sensor %monitoring

            LogisticsController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # RESEARCH FIELD MODULE BLOCK
    # --------------------------------------------------------

    FieldResearchBlock:block %science %remote {

        MeteorologySystem:system %atmospheric %science {

            AutomaticWeatherStation:weather_station %primary
            WindSensor:sensor %meteorology
            AirTemperatureSensor:sensor %meteorology
            AtmosphericPressureSensor:sensor %meteorology
            SolarRadiationSensor:sensor %meteorology

            MeteorologyController:controller %automatic
        }

        GeophysicsSystem:system %geophysics %science {

            SeismicStation:instrument %geophysics
            Magnetometer:instrument %geophysics
            GPSReferenceStation:instrument %geophysics

            SeismicSensor:sensor %monitoring
            MagneticSensor:sensor %monitoring

            GeophysicsController:controller %automatic
        }

        EnvironmentalMonitoringSystem:system %environment %science {

            SnowMonitoringStation:station_module %environment
            IceMonitoringUnit:instrument %glaciology
            EnvironmentalDataLogger:data_logger %science

            SnowDepthSensor:sensor %monitoring
            IceTemperatureSensor:sensor %monitoring
            EnvironmentalSensor:sensor %monitoring

            EnvironmentalController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # COMMUNICATION INFRASTRUCTURE BLOCK
    # --------------------------------------------------------

    CommunicationBlock:block %network %critical %external {

        ExternalSatelliteSystem:system %satellite %critical {

            PrimarySatelliteDish:antenna %primary %critical
            BackupSatelliteDish:antenna %backup

            SatelliteModem:modem %primary
            SatelliteBackupModem:modem %backup

            SatelliteSignalSensor:sensor %monitoring

            SatelliteController:controller %automatic
        }

        FieldRadioSystem:system %radio %emergency {

            BaseRadio:radio %primary
            EmergencyRadio:radio %emergency
            FieldRadio:radio %mobile

            RadioSignalSensor:sensor %monitoring

            RadioController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # SAFETY AND EMERGENCY BLOCK
    # --------------------------------------------------------

    SafetyBlock:block %safety %critical %essential {

        FireSafetySystem:system %fire %critical {

            FireSensor:sensor %monitoring %critical
            SmokeSensor:sensor %monitoring %critical
            HeatSensor:sensor %monitoring %critical

            FireAlarm:alarm %critical
            FireSuppression:suppression_system %critical

            FireSafetyController:controller %automatic %critical
        }

        EmergencySystem:system %emergency %critical {

            EmergencyAlarm:alarm %critical
            EmergencyBeacon:beacon %critical
            EmergencyLighting:lighting %emergency

            EmergencySensor:sensor %monitoring %critical
            EmergencyController:controller %automatic %critical
        }

        MedicalEmergencySystem:system %medical %emergency {

            MedicalAlarm:alarm %emergency
            EmergencyMedicalKit:medical_storage %critical
            EvacuationEquipment:equipment %emergency

            MedicalEmergencyController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # EMERGENCY SHELTER / SUMMER CAMP
    # --------------------------------------------------------

    EmergencyCampBlock:block %emergency %seasonal %essential {

        EmergencyShelter:system %emergency %critical {

            ShelterAccommodation:accommodation %emergency
            ShelterKitchen:kitchen %emergency
            ShelterOffice:office %emergency
            ShelterCommunicationRoom:communication_room %emergency

            ShelterGenerator:generator %backup %critical
            ShelterWaterTank:tank %emergency
            ShelterWasteUnit:treatment_unit %emergency

            ShelterTemperatureSensor:sensor %monitoring
            ShelterPowerSensor:sensor %monitoring
            ShelterWaterSensor:sensor %monitoring

            ShelterController:controller %automatic
        }

        SummerCampSystem:system %seasonal %logistics {

            SummerAccommodation:accommodation %seasonal
            SummerDining:dining %seasonal
            SummerStorage:storage %seasonal

            SummerCampController:controller %automatic
        }
    }
}

