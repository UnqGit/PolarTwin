}

EnvironmentalController:controller {
    function="environmental monitoring"
}

# ============================================================
# COMMUNICATION BLOCK
# ============================================================

CommunicationBlock:block {
    function="external and field communications"
    criticality=critical
}

# ============================================================
# EXTERNAL SATELLITE SYSTEM
# ============================================================

ExternalSatelliteSystem:system {
    function="external satellite communication"
    criticality=critical
}

PrimarySatelliteDish:antenna {
    function="primary satellite communication"
}

BackupSatelliteDish:antenna {
    function="backup satellite communication"
}

SatelliteModem:modem {
    function="primary satellite data link"
}

SatelliteBackupModem:modem {
    function="backup satellite data link"
}

SatelliteSignalSensor:sensor {
    measurement="satellite signal strength"
    range=0:100 unit=%
}

SatelliteController:controller {
    function="satellite communications monitoring"
}

# ============================================================
# FIELD RADIO SYSTEM
# ============================================================

FieldRadioSystem:system {
    function="field radio communications"
    criticality=high
}

BaseRadio:radio {
    function="base station radio"
}

EmergencyRadio:radio {
    function="emergency communication"
    criticality=critical
}

FieldRadio:radio {
    function="field communication"
}

RadioSignalSensor:sensor {
    measurement="radio signal strength"
    range=0:100 unit=%
}

RadioController:controller {
    function="field radio monitoring"
}

# ============================================================
# SAFETY BLOCK
# ============================================================

SafetyBlock:block {
    function="station safety and emergency systems"
    criticality=critical
}

# ============================================================
# FIRE SAFETY
# ============================================================

FireSafetySystem:system {
    function="fire detection and suppression"
    criticality=critical
}

FireSensor:sensor {
    measurement="fire"
}

SmokeSensor:sensor {
    measurement="smoke"
}

HeatSensor:sensor {
    measurement="heat"
    range=-50:200 unit=C
}

FireAlarm:alarm {
    function="fire alarm"
}

FireSuppression:suppression_system {
    function="fire suppression"
}

FireSafetyController:controller {
    function="fire safety monitoring and control"
    criticality=critical
}

# ============================================================
# EMERGENCY SYSTEM
# ============================================================

EmergencySystem:system {
    function="general emergency response"
    criticality=critical
}

EmergencyAlarm:alarm {
    function="emergency alarm"
}

EmergencyBeacon:beacon {
    function="emergency location beacon"
}

EmergencyLighting:lighting {
    function="emergency lighting"
}

EmergencySensor:sensor {
    measurement="emergency conditions"
}

EmergencyController:controller {
    function="emergency monitoring and control"
    criticality=critical
}

# ============================================================
# MEDICAL EMERGENCY
# ============================================================

MedicalEmergencySystem:system {
    function="medical emergency response"
    criticality=critical
}

MedicalAlarm:alarm {
    function="medical emergency alarm"
}

EmergencyMedicalKit:medical_storage {
    function="emergency medical supplies"
}

EvacuationEquipment:equipment {
    function="medical evacuation"
}

MedicalEmergencyController:controller {
    function="medical emergency monitoring"
    criticality=critical
}

# ============================================================
# EMERGENCY CAMP BLOCK
# ============================================================

EmergencyCampBlock:block {
    function="emergency and seasonal accommodation"
}

# ============================================================
# EMERGENCY SHELTER
# ============================================================

EmergencyShelter:system {
    function="emergency accommodation"
    capacity=13
    levels=2
    distance_from_main_station=300 unit=m
    criticality=critical
}

ShelterAccommodation:accommodation {
    capacity=13
    purpose="emergency accommodation"
}

ShelterKitchen:kitchen {
    function="emergency food preparation"
}

ShelterOffice:office {
    function="emergency administration"
}

ShelterCommunicationRoom:communication_room {
    function="emergency communications"
}

ShelterGenerator:generator {
    rating=25 unit=kVA
    function="emergency power generation"
    criticality=critical
}

ShelterWaterTank:tank {
    purpose="emergency water storage"
}

ShelterWasteUnit:treatment_unit {
    function="emergency waste management"
}

ShelterTemperatureSensor:sensor {
    measurement="shelter temperature"
    range=-50:40 unit=C
}

ShelterPowerSensor:sensor {
    measurement="shelter power"
}

ShelterWaterSensor:sensor {
    measurement="shelter water level"
    range=0:100 unit=%
}

ShelterController:controller {
    function="emergency shelter monitoring"
    criticality=critical
}

# ============================================================
# SUMMER CAMP
# ============================================================

SummerCampSystem:system {
    function="seasonal accommodation"
    status=seasonal
}

SummerAccommodation:accommodation {
    capacity=25
    purpose="summer personnel accommodation"
}

SummerDining:dining {
    function="seasonal dining"
}

SummerStorage:storage {
    purpose="seasonal supplies"
}

SummerCampController:controller {
    function="summer camp monitoring"
}
