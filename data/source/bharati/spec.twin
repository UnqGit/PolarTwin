# ============================================================
# STATION
# ============================================================

Bharati:station {
    name="Bharati Antarctic Research Station"
    latitude=-69.4068
    longitude=76.1953
    elevation=35 unit=m
    commissioned=2012
    capacity=47
    summer_capacity=72
    location="Larsemann Hills, Antarctica"
    environment="polar"
    main_building_floor_area=2162 unit=m2
    floors=3
}

# ============================================================
# MAIN BUILDING
# ============================================================

MainBuilding:block {
    dimensions="30 m x 50 m"
    floor_area=2162 unit=m2
    capacity=47
    floors=3
    construction="prefabricated"
    status=operational
}

OperationsFloor:floor {
    level=1
    function="laboratory and service"
}

LivingFloor:floor {
    level=2
    function="living and administration"
}

TechnicalFloor:floor {
    level=3
    function="technical and communications"
}

