                MaitriBuildingGeophysicalVentCurrentSensor:sensor @5
                MaitriBuildingGeophysicalVentFlowSensor:sensor @5

                MainBuildingGeophysicalController:controller @2
MainController:MainBuildingGeophysicalController[signal]@signal_controller
MainBuildingGeophysicalController:MainBuildingGeophysicalControllerVoltageSensor[data]@voltage_reading
MainBuildingGeophysicalController:MainBuildingGeophysicalControllerCurrentSensor[data]@current_reading
