                MainBuildingGeophysicalAntennaCurrentSensor:sensor @3
                MainBuildingGeophysicalAntennaFrequencySensor:sensor @3

            }

            MainBuildingResearchData:system @6 %data {

                MainBuildingResearchServer:server @0
                BackupMainBuildingResearchServer:server @1 backup(MainBuildingResearchServer) %backup

                MainBuildingResearchServerPowerSensor:sensor @2
                MainBuildingResearchServerTemperatureSensor:sensor @2

                BackupMainBuildingResearchServerPowerSensor:sensor @3
                BackupMainBuildingResearchServerTemperatureSensor:sensor @3

                MainBuildingResearchDataController:controller @2
MainController:MainBuildingResearchDataController[signal]@signal_controller
MainBuildingResearchDataController:MainBuildingResearchDataControllerVoltageSensor[data]@voltage_reading
MainBuildingResearchDataController:MainBuildingResearchDataControllerCurrentSensor[data]@current_reading
