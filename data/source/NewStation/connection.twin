


    MainBuilding:block @0 %main_building {
        MainBuildingTemperatureSensor:sensor @0
        MainBuildingAntenna:antenna @0
        MainBuildingAntennaVoltageSensor:sensor @0
        MainBuildingAntennaCurrentSensor:sensor @0
        MainBuildingAntennaFrequencySensor:sensor @0

        MainBuildingGroundFloor:floor @level=0 @0 {

            MainBuildingControlUnit:system @0 %control {
                MainController:controller @0 %master_controller
MainController:MainController[signal]@signal_controller
MainController:MainControllerVoltageSensor[data]@voltage_reading
MainController:MainControllerCurrentSensor[data]@current_reading
                MainControllerVoltageSensor:sensor @0
                MainControllerCurrentSensor:sensor @0
            }

            MainBuildingPower:system @0 %power {

                MainGenerator:generator @0 %primary

                BackupMainGenerator:generator @1 backup(MainGenerator) %backup

                MainGeneratorFlowSensor:sensor @2
                MainGeneratorTemperatureSensor:sensor @2
                MainGeneratorPowerSensor:sensor @2

                BackupMainGeneratorFlowSensor:sensor @3
                BackupMainGeneratorTemperatureSensor:sensor @3
                BackupMainGeneratorPowerSensor:sensor @3

                MainPowerController:controller @1
MainController:MainPowerController[signal]@signal_controller
MainPowerController:MainPowerControllerVoltageSensor[data]@voltage_reading
MainPowerController:MainPowerControllerCurrentSensor[data]@current_reading
                MainPowerControllerVoltageSensor:sensor @1
                MainPowerControllerCurrentSensor:sensor @1

                MainPowerAntenna:antenna @2
                MainPowerAntennaVoltageSensor:sensor @2
                MainPowerAntennaCurrentSensor:sensor @2
                MainPowerAntennaFrequencySensor:sensor @2

            }

            MainBuildingThermalControl:system @1 %thermal_control {

                MainBuildingGroundAC:air_conditioner @0 %primary
                BackupMainBuildingGroundAC:air_conditioner @1 backup(MainBuildingGroundAC) %backup

                MainBuildingGroundACTemperatureSensor:sensor @4
                MainBuildingGroundACCurrentSensor:sensor @4
                MainBuildingGroundACFlowSensor:sensor @4
                MainBuildingGroundACOutputTemperatureSensor:sensor @4
                MainBuildingGroundACVoltageSensor:sensor @4

                BackupMainBuildingGroundACTemperatureSensor:sensor @5
                BackupMainBuildingGroundACCurrentSensor:sensor @5
                BackupMainBuildingGroundACFlowSensor:sensor @5
                BackupMainBuildingGroundACOutputTemperatureSensor:sensor @5
                BackupMainBuildingGroundACVoltageSensor:sensor @5

                MainBuildingThermalController:controller @1
MainController:MainBuildingThermalController[signal]@signal_controller
MainBuildingThermalController:MainBuildingThermalControllerVoltageSensor[data]@voltage_reading
MainBuildingThermalController:MainBuildingThermalControllerCurrentSensor[data]@current_reading
                MainBuildingThermalControllerVoltageSensor:sensor @1
                MainBuildingThermalControllerCurrentSensor:sensor @1

                MainBuildingThermalAntenna:antenna @2
                MainBuildingThermalAntennaVoltageSensor:sensor @2
                MainBuildingThermalAntennaCurrentSensor:sensor @2
                MainBuildingThermalAntennaFrequencySensor:sensor @2

            }

            MainBuildingWater:system @2 %water {

                MainBuildingWaterTank:tank @0 %primary
                BackupMainBuildingWaterTank:tank @1 backup(MainBuildingWaterTank) %backup

                MainBuildingWaterPump:pump @0 %primary
                BackupMainBuildingWaterPump:pump @1 backup(MainBuildingWaterPump) %backup

                MainBuildingWaterTankVolumeSensor:sensor @2
                BackupMainBuildingWaterTankVolumeSensor:sensor @3

                MainBuildingWaterPumpVoltageSensor:sensor @2
                MainBuildingWaterPumpCurrentSensor:sensor @2
                MainBuildingWaterPumpTemperatureSensor:sensor @2
                MainBuildingWaterPumpFlowSensor:sensor @2

                BackupMainBuildingWaterPumpVoltageSensor:sensor @3
                BackupMainBuildingWaterPumpCurrentSensor:sensor @3
                BackupMainBuildingWaterPumpTemperatureSensor:sensor @3
                BackupMainBuildingWaterPumpFlowSensor:sensor @3

                MainBuildingWaterController:controller @1
MainController:MainBuildingWaterController[signal]@signal_controller
MainBuildingWaterController:MainBuildingWaterControllerVoltageSensor[data]@voltage_reading
MainBuildingWaterController:MainBuildingWaterControllerCurrentSensor[data]@current_reading
                MainBuildingWaterControllerVoltageSensor:sensor @1
                MainBuildingWaterControllerCurrentSensor:sensor @1

                MainBuildingWaterAntenna:antenna @2
                MainBuildingWaterAntennaVoltageSensor:sensor @2
                MainBuildingWaterAntennaCurrentSensor:sensor @2
                MainBuildingWaterAntennaFrequencySensor:sensor @2

            }

            MainBuildingLiving:system @0 %living {

                MainBuildingLivingStorage:storage @0
                MainBuildingLivingTemperatureSensor:sensor @1
                MainBuildingLivingController:controller @2
MainController:MainBuildingLivingController[signal]@signal_controller
MainBuildingLivingController:MainBuildingLivingControllerVoltageSensor[data]@voltage_reading
MainBuildingLivingController:MainBuildingLivingControllerCurrentSensor[data]@current_reading
                MainBuildingLivingControllerVoltageSensor:sensor @2
                MainBuildingLivingControllerCurrentSensor:sensor @2

                MainBuildingLivingAntenna:antenna @3
                MainBuildingLivingAntennaVoltageSensor:sensor @3
                MainBuildingLivingAntennaCurrentSensor:sensor @3
                MainBuildingLivingAntennaFrequencySensor:sensor @3

            }

            MainBuildingDining:system @1 %dining {

                MainBuildingDiningStorage:storage @0
                MainBuildingFoodStorage:storage @1 %food_storage

                MainBuildingDiningTemperatureSensor:sensor @2
                MainBuildingDiningController:controller @3
MainController:MainBuildingDiningController[signal]@signal_controller
MainBuildingDiningController:MainBuildingDiningControllerVoltageSensor[data]@voltage_reading
MainBuildingDiningController:MainBuildingDiningControllerCurrentSensor[data]@current_reading
                MainBuildingDiningControllerVoltageSensor:sensor @3
                MainBuildingDiningControllerCurrentSensor:sensor @3

                MainBuildingDiningAntenna:antenna @4
                MainBuildingDiningAntennaVoltageSensor:sensor @4
                MainBuildingDiningAntennaCurrentSensor:sensor @4
                MainBuildingDiningAntennaFrequencySensor:sensor @4

            }

            MainBuildingColdStorage:system @5 %cold_storage {

                MainBuildingColdStorageUnit:storage @0 %cold_storage
                MainBuildingColdStorageUnitWeightSensor:sensor @1
                MainBuildingColdStorageUnitCountSensor:sensor @1

                MainBuildingColdStorageTemperatureSensor:sensor @0

                MainBuildingColdStorageVent:vent @1

                MainBuildingColdStorageVentCurrentSensor:sensor @3
                MainBuildingColdStorageVentFlowSensor:sensor @3

                MainBuildingColdStorageController:controller @0
MainController:MainBuildingColdStorageController[signal]@signal_controller
MainBuildingColdStorageController:MainBuildingColdStorageControllerVoltageSensor[data]@voltage_reading
MainBuildingColdStorageController:MainBuildingColdStorageControllerCurrentSensor[data]@current_reading
                MainBuildingColdStorageControllerVoltageSensor:sensor @0
                MainBuildingColdStorageControllerCurrentSensor:sensor @0

                MainBuildingColdStorageAntenna:antenna @0
                MainBuildingColdStorageAntennaVoltageSensor:sensor @0
                MainBuildingColdStorageAntennaCurrentSensor:sensor @0
                MainBuildingColdStorageAntennaFrequencySensor:sensor @0

            }

            MainBuildingKitchen:system @6 %kitchen {

                MainBuildingKitchenStorage:storage @0
                MainBuildingKitchenStorageWeightSensor:sensor @1
                MainBuildingKitchenStorageCountSensor:sensor @1

                MainBuildingKitchenTemperatureSensor:sensor @0
                MainBuildingKitchenController:controller @0
MainController:MainBuildingKitchenController[signal]@signal_controller
MainBuildingKitchenController:MainBuildingKitchenControllerVoltageSensor[data]@voltage_reading
MainBuildingKitchenController:MainBuildingKitchenControllerCurrentSensor[data]@current_reading
                MainBuildingKitchenControllerVoltageSensor:sensor @0
                MainBuildingKitchenControllerCurrentSensor:sensor @0

                MainBuildingKitchenAntenna:antenna @0
                MainBuildingKitchenAntennaVoltageSensor:sensor @0
                MainBuildingKitchenAntennaCurrentSensor:sensor @0
                MainBuildingKitchenAntennaFrequencySensor:sensor @0

            }

            MainBuildingMedical:system @7 %medical {

                MainBuildingMedicalStorage:storage @0
                MainBuildingMedicalStorageWeightSensor:sensor @1
                MainBuildingMedicalStorageCountSensor:sensor @1

                MainBuildingMedicalTemperatureSensor:sensor @0
                MainBuildingMedicalController:controller @0
MainController:MainBuildingMedicalController[signal]@signal_controller
MainBuildingMedicalController:MainBuildingMedicalControllerVoltageSensor[data]@voltage_reading
MainBuildingMedicalController:MainBuildingMedicalControllerCurrentSensor[data]@current_reading
                MainBuildingMedicalControllerVoltageSensor:sensor @0
                MainBuildingMedicalControllerCurrentSensor:sensor @0

                MainBuildingMedicalAntenna:antenna @0
                MainBuildingMedicalAntennaVoltageSensor:sensor @0
                MainBuildingMedicalAntennaCurrentSensor:sensor @0
                MainBuildingMedicalAntennaFrequencySensor:sensor @0

            }

            MainBuildingSafety:system @8 %safety {

                MainBuildingFireAlarm:alarm @0
                MainBuildingEmergencyAlarm:alarm @1

                MainBuildingFireAlarmVoltageSensor:sensor @2
                MainBuildingEmergencyAlarmVoltageSensor:sensor @2
                MainBuildingFireAlarmCurrentSensor:sensor @2
                MainBuildingEmergencyAlarmCurrentSensor:sensor @2

                MainBuildingSafetyController:controller @2
MainController:MainBuildingSafetyController[signal]@signal_controller
MainBuildingSafetyController:MainBuildingSafetyControllerVoltageSensor[data]@voltage_reading
MainBuildingSafetyController:MainBuildingSafetyControllerCurrentSensor[data]@current_reading
                MainBuildingSafetyControllerVoltageSensor:sensor @2
                MainBuildingSafetyControllerCurrentSensor:sensor @2

                MainBuildingSafetyAntenna:antenna @3
                MainBuildingSafetyAntennaVoltageSensor:sensor @3
                MainBuildingSafetyAntennaCurrentSensor:sensor @3
                MainBuildingSafetyAntennaFrequencySensor:sensor @3

            }

            MainBuildingCommunication:system @9 %communications {
                MainBuildingCommunicationVentA:vent @0
                MainBuildingCommunicationVentB:vent @1

                MainBuildingCommunicationVentAVoltageSensor:sensor @2
                MainBuildingCommunicationVentACurrentSensor:sensor @2
                MainBuildingCommunicationVentBVoltageSensor:sensor @3
                MainBuildingCommunicationVentBCurrentSensor:sensor @3
                MainBuildingCommunicationVentAFlowSensor:sensor @4
                MainBuildingCommunicationVentBFlowSensor:sensor @4

                MainBuildingCommunicationServer:server @0
                BackupMainBuildingCommunicationServer:server @1 backup(MainBuildingCommunicationServer) %backup

                MainBuildingCommunicationServerPowerSensor:sensor @2
                MainBuildingCommunicationServerTemperatureSensor:sensor @2

                BackupMainBuildingCommunicationServerPowerSensor:sensor @3
                BackupMainBuildingCommunicationServerTemperatureSensor:sensor @3

                MainBuildingCommunicationAntenna:antenna @2 external@network.bandwidth
                MainBuildingCommunicationAntennaVoltageSensor:sensor @2
                MainBuildingCommunicationAntennaCurrentSensor:sensor @2
                MainBuildingCommunicationAntennaFrequencySensor:sensor @2

                MainBuildingSatelliteAntenna:antenna @3 external@network.mainland_connectivity
                MainBuildingSatelliteAntennaVoltageSensor:sensor @3
                MainBuildingSatelliteAntennaCurrentSensor:sensor @3
                MainBuildingSatelliteAntennaFrequencySensor:sensor @3


                MainBuildingCommunicationController:controller @1
MainController:MainBuildingCommunicationController[signal]@signal_controller
MainBuildingCommunicationController:MainBuildingCommunicationControllerVoltageSensor[data]@voltage_reading
MainBuildingCommunicationController:MainBuildingCommunicationControllerCurrentSensor[data]@current_reading
                MainBuildingCommunicationControllerVoltageSensor:sensor @1
                MainBuildingCommunicationControllerCurrentSensor:sensor @1

            }

            MainBuildingOperations:system @10 %operations {

                MainBuildingOperationsServer:server @0
                BackupMainBuildingOperationsServer:server @1 backup(MainBuildingOperationsServer) %backup

                MainBuildingOperationsServerPowerSensor:sensor @2
                MainBuildingOperationsServerTemperatureSensor:sensor @2

                BackupMainBuildingOperationsServerPowerSensor:sensor @3
                BackupMainBuildingOperationsServerTemperatureSensor:sensor @3

                MainBuildingOperationsController:controller @1
MainController:MainBuildingOperationsController[signal]@signal_controller
MainBuildingOperationsController:MainBuildingOperationsControllerVoltageSensor[data]@voltage_reading
MainBuildingOperationsController:MainBuildingOperationsControllerCurrentSensor[data]@current_reading
                MainBuildingOperationsControllerVoltageSensor:sensor @1
                MainBuildingOperationsControllerCurrentSensor:sensor @1

                MainBuildingOperationsAntenna:antenna @2
                MainBuildingOperationsAntennaVoltageSensor:sensor @2
                MainBuildingOperationsAntennaCurrentSensor:sensor @2
                MainBuildingOperationsAntennaFrequencySensor:sensor @2

            }

            MainBuildingPA:system @11 %public_address {

                MainBuildingPAServer:server @0
                MainBuildingPAServerPowerSensor:sensor @1
                MainBuildingPAServerTemperatureSensor:sensor @1

                MainBuildingPAAntenna:antenna @1
                MainBuildingPAAntennaVoltageSensor:sensor @1
                MainBuildingPAAntennaCurrentSensor:sensor @1
                MainBuildingPAAntennaFrequencySensor:sensor @1

                MainBuildingPAController:controller @2
MainController:MainBuildingPAController[signal]@signal_controller
MainBuildingPAController:MainBuildingPAControllerVoltageSensor[data]@voltage_reading
MainBuildingPAController:MainBuildingPAControllerCurrentSensor[data]@current_reading
                MainBuildingPAControllerVoltageSensor:sensor @2
                MainBuildingPAControllerCurrentSensor:sensor @2

            }
        }


        MainBuildingUpperFloor:floor @level=1 @0 {

            MainBuildingUpperThermalControl:system @0 %thermal_control {

                MainBuildingUpperAC:air_conditioner @0 %primary
                BackupMainBuildingUpperAC:air_conditioner @1 backup(MainBuildingUpperAC) %backup

                MainBuildingUpperACVoltageSensor:sensor @4
                MainBuildingUpperACCurrentSensor:sensor @4
                MainBuildingUpperACTemperatureSensor:sensor @4
                MainBuildingUpperACFlowSensor:sensor @4
                MainBuildingUpperACOutputTemperatureSensor:sensor @4

                BackupMainBuildingUpperACVoltageSensor:sensor @5
                BackupMainBuildingUpperACCurrentSensor:sensor @5
                BackupMainBuildingUpperACTemperatureSensor:sensor @5
                BackupMainBuildingUpperACFlowSensor:sensor @5
                BackupMainBuildingUpperACOutputTemperatureSensor:sensor @5

                MainBuildingUpperThermalController:controller @1
MainController:MainBuildingUpperThermalController[signal]@signal_controller
MainBuildingUpperThermalController:MainBuildingUpperThermalControllerVoltageSensor[data]@voltage_reading
MainBuildingUpperThermalController:MainBuildingUpperThermalControllerCurrentSensor[data]@current_reading
                MainBuildingUpperThermalControllerVoltageSensor:sensor @1
                MainBuildingUpperThermalControllerCurrentSensor:sensor @1

                MainBuildingUpperThermalAntenna:antenna @2
                MainBuildingUpperThermalAntennaVoltageSensor:sensor @2
                MainBuildingUpperThermalAntennaCurrentSensor:sensor @2
                MainBuildingUpperThermalAntennaFrequencySensor:sensor @2

            }

            MainBuildingLivingUpper:system @1 %living {

                MainBuildingUpperLivingStorage:storage @0
                
                MainBuildingUpperLivingStorageWeightSensor:sensor @1
                MainBuildingUpperLivingStorageCountSensor:sensor @1
                MainBuildingUpperLivingTemperatureSensor:sensor @1

                MainBuildingUpperLivingController:controller @2
MainController:MainBuildingUpperLivingController[signal]@signal_controller
MainBuildingUpperLivingController:MainBuildingUpperLivingControllerVoltageSensor[data]@voltage_reading
MainBuildingUpperLivingController:MainBuildingUpperLivingControllerCurrentSensor[data]@current_reading
                MainBuildingUpperLivingControllerVoltageSensor:sensor @2
                MainBuildingUpperLivingControllerCurrentSensor:sensor @2

                MainBuildingUpperLivingAntenna:antenna @3
                MainBuildingUpperLivingAntennaVoltageSensor:sensor @3
                MainBuildingUpperLivingAntennaCurrentSensor:sensor @3
                MainBuildingUpperLivingAntennaFrequencySensor:sensor @3

            }

            MainBuildingLounge:system @2 %lounge {

                MainBuildingLoungeStorage:storage @0

                MainBuildingLoungeStorageWeightSensor:sensor @1
                MainBuildingLoungeStorageCountSensor:sensor @1
                MainBuildingLoungeTemperatureSensor:sensor @1

                MainBuildingLoungeController:controller @2
MainController:MainBuildingLoungeController[signal]@signal_controller
MainBuildingLoungeController:MainBuildingLoungeControllerVoltageSensor[data]@voltage_reading
MainBuildingLoungeController:MainBuildingLoungeControllerCurrentSensor[data]@current_reading
                MainBuildingLoungeControllerVoltageSensor:sensor @2
                MainBuildingLoungeControllerCurrentSensor:sensor @2

                MainBuildingLoungeAntenna:antenna @3
                MainBuildingLoungeAntennaVoltageSensor:sensor @3
                MainBuildingLoungeAntennaCurrentSensor:sensor @3
                MainBuildingLoungeAntennaFrequencySensor:sensor @3

            }

            MainBuildingLaboratories:system @3 %laboratories {

                AtmosphericResearchLab:system @0 %atmospheric {
                    AtmosphericResearchLabStorage:storage @0
                    AtmosphericResearchLabStorageWeightSensor:sensor @1
                    AtmosphericResearchLabStorageCountSensor:sensor @1
                    AtmosphericResearchLabTemperatureSensor:sensor @2
                    AtmosphericResearchLabController:controller @3
MainController:AtmosphericResearchLabController[signal]@signal_controller
AtmosphericResearchLabController:AtmosphericResearchLabControllerVoltageSensor[data]@voltage_reading
AtmosphericResearchLabController:AtmosphericResearchLabControllerCurrentSensor[data]@current_reading
                    AtmosphericResearchLabControllerVoltageSensor:sensor @3
                    AtmosphericResearchLabControllerCurrentSensor:sensor @3

                    AtmosphericResearchLabAntenna:antenna @4
                    AtmosphericResearchLabAntennaVoltageSensor:sensor @4
                    AtmosphericResearchLabAntennaCurrentSensor:sensor @4
                    AtmosphericResearchLabAntennaFrequencySensor:sensor @4

                }

                BiologicalResearchLab:system @1 %biological {
                    BiologicalResearchLabStorage:storage @0
                    BiologicalResearchLabStorageWeightSensor:sensor @1
                    BiologicalResearchLabStorageCountSensor:sensor @1
                    BiologicalResearchLabTemperatureSensor:sensor @2
                    BiologicalResearchLabController:controller @3
MainController:BiologicalResearchLabController[signal]@signal_controller
BiologicalResearchLabController:BiologicalResearchLabControllerVoltageSensor[data]@voltage_reading
BiologicalResearchLabController:BiologicalResearchLabControllerCurrentSensor[data]@current_reading
                    BiologicalResearchLabControllerVoltageSensor:sensor @3
                    BiologicalResearchLabControllerCurrentSensor:sensor @3

                    BiologicalResearchLabAntenna:antenna @4
                    BiologicalResearchLabAntennaVoltageSensor:sensor @4
                    BiologicalResearchLabAntennaCurrentSensor:sensor @4
                    BiologicalResearchLabAntennaFrequencySensor:sensor @4

                }

                EarthScienceResearchLab:system @2 %earth_science {
                    EarthScienceResearchLabStorage:storage @0
                    EarthScienceResearchLabStorageWeightSensor:sensor @1
                    EarthScienceResearchLabStorageCountSensor:sensor @1
                    EarthScienceResearchLabTemperatureSensor:sensor @2
                    EarthScienceResearchLabController:controller @3
MainController:EarthScienceResearchLabController[signal]@signal_controller
EarthScienceResearchLabController:EarthScienceResearchLabControllerVoltageSensor[data]@voltage_reading
EarthScienceResearchLabController:EarthScienceResearchLabControllerCurrentSensor[data]@current_reading
                    EarthScienceResearchLabControllerVoltageSensor:sensor @3
                    EarthScienceResearchLabControllerCurrentSensor:sensor @3

                    EarthScienceResearchLabAntenna:antenna @4
                    EarthScienceResearchLabAntennaVoltageSensor:sensor @4
                    EarthScienceResearchLabAntennaCurrentSensor:sensor @4
                    EarthScienceResearchLabAntennaFrequencySensor:sensor @4

                }

                SpacePhysicsResearchLab:system @3 %space_physics {
                    SpacePhysicsResearchLabStorage:storage @0
                    SpacePhysicsResearchLabStorageWeightSensor:sensor @1
                    SpacePhysicsResearchLabStorageCountSensor:sensor @1
                    SpacePhysicsResearchLabTemperatureSensor:sensor @2
                    SpacePhysicsResearchLabController:controller @3
MainController:SpacePhysicsResearchLabController[signal]@signal_controller
SpacePhysicsResearchLabController:SpacePhysicsResearchLabControllerVoltageSensor[data]@voltage_reading
SpacePhysicsResearchLabController:SpacePhysicsResearchLabControllerCurrentSensor[data]@current_reading
                    SpacePhysicsResearchLabControllerVoltageSensor:sensor @3
                    SpacePhysicsResearchLabControllerCurrentSensor:sensor @3

                    SpacePhysicsResearchLabAntenna:antenna @4
                    SpacePhysicsResearchLabAntennaVoltageSensor:sensor @4
                    SpacePhysicsResearchLabAntennaCurrentSensor:sensor @4
                    SpacePhysicsResearchLabAntennaFrequencySensor:sensor @4

                }

                MainBuildingLaboratoryVent:vent @4
                MainBuildingLaboratoryVentVoltageSensor:sensor @5
                MainBuildingLaboratoryVentCurrentSensor:sensor @5
                MainBuildingLaboratoryVentFlowSensor:sensor @5

                MainBuildingLaboratoryTemperatureSensor:sensor @4

                MainBuildingLaboratoryController:controller @2
MainController:MainBuildingLaboratoryController[signal]@signal_controller
MainBuildingLaboratoryController:MainBuildingLaboratoryControllerVoltageSensor[data]@voltage_reading
MainBuildingLaboratoryController:MainBuildingLaboratoryControllerCurrentSensor[data]@current_reading
                MainBuildingLaboratoryControllerVoltageSensor:sensor @2
                MainBuildingLaboratoryControllerCurrentSensor:sensor @2

                MainBuildingLaboratoryAntenna:antenna @3
                MainBuildingLaboratoryAntennaVoltageSensor:sensor @3
                MainBuildingLaboratoryAntennaCurrentSensor:sensor @3
                MainBuildingLaboratoryAntennaFrequencySensor:sensor @3

            }

            MainBuildingEnvironmentalObservation:system @4 %environmental_observation {

                MainBuildingTemperatureSensor:sensor @0 external@weather.temperature
                MainBuildingHumiditySensor:sensor @1 external@weather.humidity
                MainBuildingPressureSensor:sensor @2 external@weather.pressure
                MainBuildingWindSpeedSensor:sensor @3 external@weather.wind_speed
                MainBuildingCO2Sensor:sensor @4 external@weather.co2_level
                MainBuildingO2Sensor:sensor @5 external@weather.o2_level

                MainBuildingEnvironmentalAntenna:antenna @6
                MainBuildingEnvironmentalAntennaVoltageSensor:sensor @6
                MainBuildingEnvironmentalAntennaCurrentSensor:sensor @6
                MainBuildingEnvironmentalAntennaFrequencySensor:sensor @6

            }

            MainBuildingGeophysicalResearch:system @5 %geophysics {

                MaitriSeismicServer:server @0
