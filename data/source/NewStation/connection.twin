                MainBuildingResearchDataControllerCurrentSensor:sensor @2

                MainBuildingResearchDataAntenna:antenna @3
                MainBuildingResearchDataAntennaVoltageSensor:sensor @3
                MainBuildingResearchDataAntennaCurrentSensor:sensor @3
                MainBuildingResearchDataAntennaFrequencySensor:sensor @3

            }
        }
    }


    /*
    * GENERATOR COMPLEX
    *
    * Kept separate from the main building so generator resource
    * allocation can be simulated independently.
    */

    GeneratorComplex:block @1 %power_generation {
        GeneratorComplexTemperatureSensor:sensor @1
        
        GeneratorComplexGenerator1:generator @0 %primary
        GeneratorComplexGenerator2:generator @1 %primary

        GeneratorComplexBackupGenerator1:generator @2 backup(GeneratorComplexGenerator1) %backup
        GeneratorComplexBackupGenerator2:generator @3 backup(GeneratorComplexGenerator2) %backup

        GeneratorComplexGenerator1FlowSensor:sensor @4
        GeneratorComplexGenerator1TemperatureSensor:sensor @4
        GeneratorComplexGenerator1PowerSensor:sensor @4

        GeneratorComplexGenerator2FlowSensor:sensor @5
        GeneratorComplexGenerator2TemperatureSensor:sensor @5
        GeneratorComplexGenerator2PowerSensor:sensor @5

        GeneratorComplexBackupGenerator1FlowSensor:sensor @6
        GeneratorComplexBackupGenerator1TemperatureSensor:sensor @6
        GeneratorComplexBackupGenerator1PowerSensor:sensor @6

        GeneratorComplexBackupGenerator2FlowSensor:sensor @7
        GeneratorComplexBackupGenerator2TemperatureSensor:sensor @7
        GeneratorComplexBackupGenerator2PowerSensor:sensor @7

        GeneratorComplexController:controller @1
MainController:GeneratorComplexController[signal]@signal_controller
GeneratorComplexController:GeneratorComplexControllerVoltageSensor[data]@voltage_reading
GeneratorComplexController:GeneratorComplexControllerCurrentSensor[data]@current_reading
        GeneratorComplexControllerVoltageSensor:sensor @1
        GeneratorComplexControllerCurrentSensor:sensor @1

        GeneratorComplexAntenna:antenna @2
        GeneratorComplexAntennaVoltageSensor:sensor @2
        GeneratorComplexAntennaCurrentSensor:sensor @2
        GeneratorComplexAntennaFrequencySensor:sensor @2

    }


    /*
    * FUEL FARM
    */

    FuelFarm:block @2 %fuel {
        FuelFarmTemperatureSensor:sensor @2
        FuelFarmAntenna:antenna @2
        FuelFarmAntennaVoltageSensor:sensor @2
        FuelFarmAntennaCurrentSensor:sensor @2
        FuelFarmAntennaFrequencySensor:sensor @2

        FuelTankA:tank @0 %primary
        FuelTankB:tank @1 %primary
        FuelTankC:tank @2 %reserve

        BackupFuelTankA:tank @3 backup(FuelTankA) %backup

        FuelTransferPumpA:pump @0 %primary
        FuelTransferPumpB:pump @1 %primary

        BackupFuelTransferPumpA:pump @2 backup(FuelTransferPumpA) %backup
        BackupFuelTransferPumpB:pump @3 backup(FuelTransferPumpB) %backup

        FuelTankAVolumeSensor:sensor @4
        FuelTankBVolumeSensor:sensor @4
        FuelTankCVolumeSensor:sensor @4
        BackupFuelTankAVolumeSensor:sensor @5

        FuelTransferPumpAVoltageSensor:sensor @4
        FuelTransferPumpACurrentSensor:sensor @4
        FuelTransferPumpATemperatureSensor:sensor @4
        FuelTransferPumpAFlowSensor:sensor @4

        FuelTransferPumpBVoltageSensor:sensor @5
        FuelTransferPumpBCurrentSensor:sensor @5
        FuelTransferPumpBTemperatureSensor:sensor @5
        FuelTransferPumpBFlowSensor:sensor @5

        BackupFuelTransferPumpAVoltageSensor:sensor @6
        BackupFuelTransferPumpACurrentSensor:sensor @6
        BackupFuelTransferPumpATemperatureSensor:sensor @6
        BackupFuelTransferPumpAFlowSensor:sensor @6

        BackupFuelTransferPumpBVoltageSensor:sensor @7
        BackupFuelTransferPumpBCurrentSensor:sensor @7
        BackupFuelTransferPumpBTemperatureSensor:sensor @7
        BackupFuelTransferPumpBFlowSensor:sensor @7

        FuelFarmController:controller @1
MainController:FuelFarmController[signal]@signal_controller
FuelFarmController:FuelFarmControllerVoltageSensor[data]@voltage_reading
FuelFarmController:FuelFarmControllerCurrentSensor[data]@current_reading
        FuelFarmControllerVoltageSensor:sensor @1
        FuelFarmControllerCurrentSensor:sensor @1
    }


    /*
    * FUEL STATION
    */

    FuelStation:block @3 %fuel_distribution {
        FuelStationTemperatureSensor:sensor @1

        FuelStationTank:tank @0
        FuelStationPump:pump @0

        FuelStationTankVolumeSensor:sensor @1

        FuelStationPumpVoltageSensor:sensor @2
        FuelStationPumpCurrentSensor:sensor @2
        FuelStationPumpTemperatureSensor:sensor @2
        FuelStationPumpFlowSensor:sensor @2

        FuelStationController:controller @1
MainController:FuelStationController[signal]@signal_controller
FuelStationController:FuelStationControllerVoltageSensor[data]@voltage_reading
FuelStationController:FuelStationControllerCurrentSensor[data]@current_reading
        FuelStationControllerVoltageSensor:sensor @1
        FuelStationControllerCurrentSensor:sensor @1

        FuelStationAntenna:antenna @2
        FuelStationAntennaVoltageSensor:sensor @2
        FuelStationAntennaCurrentSensor:sensor @2
        FuelStationAntennaFrequencySensor:sensor @2
    }


    /*
    * LAKE WATER PUMP HOUSE
    */

    LakeWaterPumpHouse:block @4 %water_supply {
        LakeWaterPumpHouseTemperatureSensor:sensor @1

        LakeWaterTank:tank @0 %source
        BackupLakeWaterTank:tank @1 backup(LakeWaterTank) %backup

        LakeWaterPumpA:pump @0 %primary
        LakeWaterPumpB:pump @1 backup(LakeWaterPumpA) %backup

        LakeWaterTankVolumeSensor:sensor @2
        BackupLakeWaterTankVolumeSensor:sensor @3

        LakeWaterPumpAVoltageSensor:sensor @2
        LakeWaterPumpACurrentSensor:sensor @2
        LakeWaterPumpATemperatureSensor:sensor @2
        LakeWaterPumpAFlowSensor:sensor @2

        LakeWaterPumpBVoltageSensor:sensor @3
        LakeWaterPumpBCurrentSensor:sensor @3
        LakeWaterPumpBTemperatureSensor:sensor @3
        LakeWaterPumpBFlowSensor:sensor @3

        LakeWaterPumpHouseController:controller @1
MainController:LakeWaterPumpHouseController[signal]@signal_controller
LakeWaterPumpHouseController:LakeWaterPumpHouseControllerVoltageSensor[data]@voltage_reading
LakeWaterPumpHouseController:LakeWaterPumpHouseControllerCurrentSensor[data]@current_reading
        LakeWaterPumpHouseControllerVoltageSensor:sensor @1
        LakeWaterPumpHouseControllerCurrentSensor:sensor @1

        LakeWaterPumpHouseAntenna:antenna @2
        LakeWaterPumpHouseAntennaVoltageSensor:sensor @2
        LakeWaterPumpHouseAntennaCurrentSensor:sensor @2
        LakeWaterPumpHouseAntennaFrequencySensor:sensor @2
    }


    /*
    * SUMMER CAMP
    *
    * NCPOR describes the summer facility as containerized living
    * modules supporting approximately 40 people.
    */

    SummerCamp:block @5 %summer_facility {
        SummerCampTemperatureSensor:sensor @1
        SummerCampAntenna:antenna @1
        SummerCampAntennaVoltageSensor:sensor @1
        SummerCampAntennaCurrentSensor:sensor @1
        SummerCampAntennaFrequencySensor:sensor @1

        SummerCampFloor:floor @level=0 @0 {

            SummerCampPower:system @0 {

                SummerCampPowerVent:vent @1
                SummerCampPowerVentVoltageSensor:sensor @1
                SummerCampPowerVentCurrentSensor:sensor @1
                SummerCampPowerVentFlowSensor:sensor @1

                SummerCampGenerator:generator @0
                BackupSummerCampGenerator:generator @1 backup(SummerCampGenerator) %backup

                SummerCampGeneratorFlowSensor:sensor @2
                SummerCampGeneratorTemperatureSensor:sensor @2
                SummerCampGeneratorPowerSensor:sensor @2

                BackupSummerCampGeneratorFlowSensor:sensor @3
                BackupSummerCampGeneratorTemperatureSensor:sensor @3
                BackupSummerCampGeneratorPowerSensor:sensor @3

                SummerCampPowerController:controller @1
MainController:SummerCampPowerController[signal]@signal_controller
SummerCampPowerController:SummerCampPowerControllerVoltageSensor[data]@voltage_reading
SummerCampPowerController:SummerCampPowerControllerCurrentSensor[data]@current_reading
                SummerCampPowerControllerVoltageSensor:sensor @1
                SummerCampPowerControllerCurrentSensor:sensor @1

                SummerCampPowerAntenna:antenna @2
                SummerCampPowerAntennaVoltageSensor:sensor @2
                SummerCampPowerAntennaCurrentSensor:sensor @2
                SummerCampPowerAntennaFrequencySensor:sensor @2

            }

            SummerCampThermalControl:system @1 %thermal_control {

                SummerCampAC:air_conditioner @0
                BackupSummerCampAC:air_conditioner @1 backup(SummerCampAC) %backup

                SummerCampACVoltageSensor:sensor @4
                SummerCampACCurrentSensor:sensor @4
                SummerCampACTemperatureSensor:sensor @4
                SummerCampACFlowSensor:sensor @4
                SummerCampACOutputTemperatureSensor:sensor @4

                BackupSummerCampACVoltageSensor:sensor @5
                BackupSummerCampACCurrentSensor:sensor @5
                BackupSummerCampACTemperatureSensor:sensor @5
                BackupSummerCampACFlowSensor:sensor @5
                BackupSummerCampACOutputTemperatureSensor:sensor @5

                SummerCampThermalController:controller @1
MainController:SummerCampThermalController[signal]@signal_controller
SummerCampThermalController:SummerCampThermalControllerVoltageSensor[data]@voltage_reading
SummerCampThermalController:SummerCampThermalControllerCurrentSensor[data]@current_reading
                SummerCampThermalControllerVoltageSensor:sensor @1
                SummerCampThermalControllerCurrentSensor:sensor @1

                SummerCampThermalAntenna:antenna @2
                SummerCampThermalAntennaVoltageSensor:sensor @2
                SummerCampThermalAntennaCurrentSensor:sensor @2
                SummerCampThermalAntennaFrequencySensor:sensor @2

            }

            SummerCampLiving:system @2 %living {

                SummerCampLivingStorageA:storage @0
                SummerCampLivingStorageB:storage @1
                SummerCampLivingTemperatureSensor:sensor @2

                SummerCampLivingStorageAWeightSensor:sensor @2
                SummerCampLivingStorageACountSensor:sensor @2

                SummerCampLivingStorageBWeightSensor:sensor @3
                SummerCampLivingStorageBCountSensor:sensor @3

                SummerCampLivingController:controller @4
MainController:SummerCampLivingController[signal]@signal_controller
SummerCampLivingController:SummerCampLivingControllerVoltageSensor[data]@voltage_reading
SummerCampLivingController:SummerCampLivingControllerCurrentSensor[data]@current_reading
                SummerCampLivingControllerVoltageSensor:sensor @4
                SummerCampLivingControllerCurrentSensor:sensor @4

                SummerCampLivingAntenna:antenna @5
                SummerCampLivingAntennaVoltageSensor:sensor @5
                SummerCampLivingAntennaCurrentSensor:sensor @5
                SummerCampLivingAntennaFrequencySensor:sensor @5

            }

            SummerCampKitchen:system @3 %kitchen {

                SummerCampKitchenStorage:storage @0
                SummerCampKitchenTemperatureSensor:sensor @2

                SummerCampKitchenStorageWeightSensor:sensor @2
                SummerCampKitchenStorageCountSensor:sensor @2

                SummerCampKitchenController:controller @4
MainController:SummerCampKitchenController[signal]@signal_controller
SummerCampKitchenController:SummerCampKitchenControllerVoltageSensor[data]@voltage_reading
SummerCampKitchenController:SummerCampKitchenControllerCurrentSensor[data]@current_reading
                SummerCampKitchenControllerVoltageSensor:sensor @4
                SummerCampKitchenControllerCurrentSensor:sensor @4

                SummerCampKitchenAntenna:antenna @5
                SummerCampKitchenAntennaVoltageSensor:sensor @5
                SummerCampKitchenAntennaCurrentSensor:sensor @5
                SummerCampKitchenAntennaFrequencySensor:sensor @5

            }

            SummerCampWater:system @4 %water {

                SummerCampWaterTank:tank @0
                SummerCampWaterPump:pump @0

                SummerCampWaterTankVolumeSensor:sensor @1

                SummerCampWaterPumpVoltageSensor:sensor @2
                SummerCampWaterPumpCurrentSensor:sensor @2
                SummerCampWaterPumpTemperatureSensor:sensor @2
                SummerCampWaterPumpFlowSensor:sensor @2

                SummerCampWaterController:controller @1
MainController:SummerCampWaterController[signal]@signal_controller
SummerCampWaterController:SummerCampWaterControllerVoltageSensor[data]@voltage_reading
SummerCampWaterController:SummerCampWaterControllerCurrentSensor[data]@current_reading
                SummerCampWaterControllerVoltageSensor:sensor @1
                SummerCampWaterControllerCurrentSensor:sensor @1

                SummerCampWaterAntenna:antenna @2
                SummerCampWaterAntennaVoltageSensor:sensor @2
                SummerCampWaterAntennaCurrentSensor:sensor @2
                SummerCampWaterAntennaFrequencySensor:sensor @2

            }

            SummerCampSafety:system @5 %safety {

                SummerCampFireAlarm:alarm @0
                SummerCampEmergencyAlarm:alarm @1

                SummerCampFireAlarmVoltageSensor:sensor @1
                SummerCampFireAlarmVCurrentSensor:sensor @1

                SummerCampEmergencyAlarmVoltageSensor:sensor @1
                SummerCampEmergencyAlarmCurrentSensor:sensor @1
                
                SummerCampSafetyController:controller @2
MainController:SummerCampSafetyController[signal]@signal_controller
SummerCampSafetyController:SummerCampSafetyControllerVoltageSensor[data]@voltage_reading
SummerCampSafetyController:SummerCampSafetyControllerCurrentSensor[data]@current_reading
                SummerCampSafetyControllerVoltageSensor:sensor @2
                SummerCampSafetyControllerCurrentSensor:sensor @2

                SummerCampSafetyAntenna:antenna @3
                SummerCampSafetyAntennaVoltageSensor:sensor @3
                SummerCampSafetyAntennaCurrentSensor:sensor @3
                SummerCampSafetyAntennaFrequencySensor:sensor @3

            }
        }
    }


    /*
    * CONTAINERIZED / MODULAR FACILITIES
    */

    ContainerModules:block @6 %containerized_modules {
        ContainerModulesTemperatureSensor:sensor @1
        ContainerModulesAntenna:antenna @1
        ContainerModulesAntennaVoltageSensor:sensor @1
        ContainerModulesAntennaCurrentSensor:sensor @1
        ContainerModulesAntennaFrequencySensor:sensor @1

        ContainerLiving:system @0 %living {

            ContainerLivingStorage:storage @0
            ContainerLivingTemperatureSensor:sensor @1

            ContainerLivingVent:vent @1

            ContainerLivingVentVoltageSensor:sensor @3
            ContainerLivingVentCurrentSensor:sensor @3
            ContainerLivingVentFlowSensor:sensor @3

            ContainerLivingController:controller @2
MainController:ContainerLivingController[signal]@signal_controller
ContainerLivingController:ContainerLivingControllerVoltageSensor[data]@voltage_reading
ContainerLivingController:ContainerLivingControllerCurrentSensor[data]@current_reading
            ContainerLivingControllerVoltageSensor:sensor @2
            ContainerLivingControllerCurrentSensor:sensor @2

            ContainerLivingAntenna:antenna @3
            ContainerLivingAntennaVoltageSensor:sensor @3
            ContainerLivingAntennaCurrentSensor:sensor @3
            ContainerLivingAntennaFrequencySensor:sensor @3

        }

        ContainerLaboratory:system @1 %laboratory {

            ContainerLaboratoryStorage:storage @0
            ContainerLaboratoryTemperatureSensor:sensor @1

            ContainerLaboratoryVent:vent @0

            ContainerLaboratoryVentVoltageSensor:sensor @2
            ContainerLaboratoryVentCurrentSensor:sensor @2
            ContainerLaboratoryVentFlowSensor:sensor @2

            ContainerLaboratoryController:controller @2
MainController:ContainerLaboratoryController[signal]@signal_controller
ContainerLaboratoryController:ContainerLaboratoryControllerVoltageSensor[data]@voltage_reading
ContainerLaboratoryController:ContainerLaboratoryControllerCurrentSensor[data]@current_reading
            ContainerLaboratoryControllerVoltageSensor:sensor @2
            ContainerLaboratoryControllerCurrentSensor:sensor @2

            ContainerLaboratoryAntenna:antenna @3
            ContainerLaboratoryAntennaVoltageSensor:sensor @3
            ContainerLaboratoryAntennaCurrentSensor:sensor @3
            ContainerLaboratoryAntennaFrequencySensor:sensor @3

        }

        ContainerStorage:system @2 %storage {

            ContainerGeneralStorage:storage @0
            ContainerColdStorage:storage @1
            
            ContainerGeneralStorageWeightSensor:sensor @1
            ContainerGeneralStorageCountSensor:sensor @2
            ContainerColdStorageWeightSensor:sensor @2
            ContainerColdStorageCountSensor:sensor @2

            ContainerStorageTemperatureSensor:sensor @2
            
            ContainerStorageController:controller @3
MainController:ContainerStorageController[signal]@signal_controller
ContainerStorageController:ContainerStorageControllerVoltageSensor[data]@voltage_reading
ContainerStorageController:ContainerStorageControllerCurrentSensor[data]@current_reading
            ContainerStorageControllerVoltageSensor:sensor @3
            ContainerStorageControllerCurrentSensor:sensor @3

            ContainerStorageAntenna:antenna @4
            ContainerStorageAntennaVoltageSensor:sensor @4
            ContainerStorageAntennaCurrentSensor:sensor @4
            ContainerStorageAntennaFrequencySensor:sensor @4

        }
    }


    /*
    * WORKSHOP / GARAGE AND FIELD VEHICLES
    *
    * Vehicles are represented only as supported vehicle leaf
    * components. No unsupported garage machinery types are invented.
    */

    WorkshopGarage:block @7 %workshop %garage {
        WorkshopGarageTemperatureSensor:sensor @1

        WorkshopStorage:storage @0
        WorkshopPartsStorage:storage @1
        WorkshopToolsStorage:storage @2
        
        WorkshopStorageWeightSensor:sensor @1
        WorkshopStorageCountSensor:sensor @1

        WorkshopPartsStorageWeightSensor:sensor @2
        WorkshopPartsStorageCountSensor:sensor @2

        WorkshopToolsStorageWeightSensor:sensor @3
        WorkshopToolsStorageCountSensor:sensor @3

        PistenBully01:vehicle @0 %snow_vehicle
        PistenBully02:vehicle @1 %snow_vehicle
        SnowScooter01:vehicle @2 %snow_vehicle
        SnowScooter02:vehicle @3 %snow_vehicle
        UtilityVehicle01:vehicle @4 %field_vehicle

        WorkshopTemperatureSensor:sensor @5
        WorkshopController:controller @2
MainController:WorkshopController[signal]@signal_controller
WorkshopController:WorkshopControllerVoltageSensor[data]@voltage_reading
WorkshopController:WorkshopControllerCurrentSensor[data]@current_reading
        WorkshopControllerVoltageSensor:sensor @2
        WorkshopControllerCurrentSensor:sensor @2

        WorkshopAntenna:antenna @3
        WorkshopAntennaVoltageSensor:sensor @3
        WorkshopAntennaCurrentSensor:sensor @3
        WorkshopAntennaFrequencySensor:sensor @3

    }


    /*
    * LOGISTICS / GENERAL STORAGE
    */

    LogisticsStorage:block @8 %logistics {
        LogisticsStorageTemperatureSensor:sensor @2
        LogisticsStorageAntenna:antenna @2
        LogisticsStorageAntennaVoltageSensor:sensor @2
        LogisticsStorageAntennaCurrentSensor:sensor @2
        LogisticsStorageAntennaFrequencySensor:sensor @2

        ExpeditionSupplyStorage:storage @0
        ExpeditionSupplyStorageWeightSensor:sensor @1
        ExpeditionSupplyStorageCountSensor:sensor @2
        
        FoodReserveStorage:storage @1
        FoodReserveStorageWeightSensor:sensor @1
        FoodReserveStorageCountSensor:sensor @2
        
        ScientificEquipmentStorage:storage @2
        ScientificEquipmentStorageWeightSensor:sensor @1
        ScientificEquipmentStorageCountSensor:sensor @2
        
        SparePartsStorage:storage @3
        SparePartsStorageWeightSensor:sensor @1
        SparePartsStorageCountSensor:sensor @2
        
        SafetyEquipmentStorage:storage @4
        SafetyEquipmentStorageWeightSensor:sensor @1
        SafetyEquipmentStorageCountSensor:sensor @2

        LogisticsStorageController:controller @1
MainController:LogisticsStorageController[signal]@signal_controller
LogisticsStorageController:LogisticsStorageControllerVoltageSensor[data]@voltage_reading
LogisticsStorageController:LogisticsStorageControllerCurrentSensor[data]@current_reading
        LogisticsStorageControllerVoltageSensor:sensor @1
        LogisticsStorageControllerCurrentSensor:sensor @1

    }


    /*
    * WASTE / SANITARY SUPPORT
    *
    * The hierarchy models storage/tank/pump resources without
    * introducing an unsupported wastewater-specific component type.
    */

    WasteManagement:block @9 %waste_management {
        WasteManagementTemperatureSensor:sensor @9
        WasteManagementAntenna:antenna @9
        WasteManagementAntennaVoltageSensor:sensor @9
        WasteManagementAntennaCurrentSensor:sensor @9
        WasteManagementAntennaFrequencySensor:sensor @9

        WasteWaterSystem:system @0 {

            WasteWaterTank:tank @0
            BackupWasteWaterTank:tank @1 backup(WasteWaterTank) %backup

            WasteWaterPump:pump @0
            BackupWasteWaterPump:pump @1 backup(WasteWaterPump) %backup

            WasteWaterTankVolumeSensor:sensor @2
            BackupWasteWaterTankVolumeSensor:sensor @3

            WasteWaterPumpVoltageSensor:sensor @2
            WasteWaterPumpCurrentSensor:sensor @2
            WasteWaterPumpTemperatureSensor:sensor @2
            WasteWaterPumpFlowSensor:sensor @2

            BackupWasteWaterPumpVoltageSensor:sensor @3
            BackupWasteWaterPumpCurrentSensor:sensor @3
            BackupWasteWaterPumpTemperatureSensor:sensor @3
            BackupWasteWaterPumpFlowSensor:sensor @3

            WasteWaterController:controller @1
MainController:WasteWaterController[signal]@signal_controller
WasteWaterController:WasteWaterControllerVoltageSensor[data]@voltage_reading
WasteWaterController:WasteWaterControllerCurrentSensor[data]@current_reading
            WasteWaterControllerVoltageSensor:sensor @1
            WasteWaterControllerCurrentSensor:sensor @1

            WasteWaterAntenna:antenna @2
            WasteWaterAntennaVoltageSensor:sensor @2
            WasteWaterAntennaCurrentSensor:sensor @2
            WasteWaterAntennaFrequencySensor:sensor @2

        }

        WasteStorageSystem:system @1 {

            WasteStorage:storage @0
            WasteStorageWeightSensor:sensor @1
            WasteStorageCountSensor:sensor @1

            WasteStorageTemperatureSensor:sensor @1

            WasteStorageController:controller @2
MainController:WasteStorageController[signal]@signal_controller
WasteStorageController:WasteStorageControllerVoltageSensor[data]@voltage_reading
WasteStorageController:WasteStorageControllerCurrentSensor[data]@current_reading
            WasteStorageControllerVoltageSensor:sensor @2
            WasteStorageControllerCurrentSensor:sensor @2

            WasteStorageAntenna:antenna @3
            WasteStorageAntennaVoltageSensor:sensor @3
            WasteStorageAntennaCurrentSensor:sensor @3
            WasteStorageAntennaFrequencySensor:sensor @3

        }
    }


    /*
    * FIELD RESEARCH / ENVIRONMENTAL OBSERVATION
    */

    FieldResearch:block @10 %research {
        FieldResearchTemperatureSensor:sensor @1
        FieldResearchAntenna:antenna @1
        FieldResearchAntennaVoltageSensor:sensor @1
        FieldResearchAntennaCurrentSensor:sensor @1
        FieldResearchAntennaFrequencySensor:sensor @1

        FieldResearchStorage:storage @0
        FieldResearchStorageWeightSensor:sensor @0
        FieldResearchStorageCountSensor:sensor @0
        
        FieldResearchController:controller @1
MainController:FieldResearchController[signal]@signal_controller
FieldResearchController:FieldResearchControllerVoltageSensor[data]@voltage_reading
FieldResearchController:FieldResearchControllerCurrentSensor[data]@current_reading
        FieldResearchControllerVoltageSensor:sensor @1
        FieldResearchControllerCurrentSensor:sensor @1

    }


    /*
    * PERMANENT GEOPHYSICAL OBSERVATION
    *
    * NCPOR documents a permanent seismological observatory and GPS
    * facility at Maitri.
    */

    GeophysicalObservation:block @11 %scientific_observation {
        GeophysicalObservationTemperatureSensor:sensor @1
        GeophysicalObservationAntenna:antenna @1
        GeophysicalObservationAntennaVoltageSensor:sensor @1
        GeophysicalObservationAntennaCurrentSensor:sensor @1
        GeophysicalObservationAntennaFrequencySensor:sensor @1

        SeismologicalObservation:system @0 {
            SeismologicalObservationVent:vent @1
            SeismologicalObservationVentVoltageSensor:sensor @1
            SeismologicalObservationVentCurrentSensor:sensor @1
            SeismologicalObservationVentFlowSensor:sensor @1

            SeismologicalServer:server @0
            BackupSeismologicalServer:server @1 backup(SeismologicalServer) %backup

            SeismologicalServerPowerSensor:sensor @2
            SeismologicalServerTemperatureSensor:sensor @2

            BackupSeismologicalServerPowerSensor:sensor @3
            BackupSeismologicalServerTemperatureSensor:sensor @3

            SeismologicalController:controller @1
MainController:SeismologicalController[signal]@signal_controller
SeismologicalController:SeismologicalControllerVoltageSensor[data]@voltage_reading
SeismologicalController:SeismologicalControllerCurrentSensor[data]@current_reading
            SeismologicalControllerVoltageSensor:sensor @1
            SeismologicalControllerCurrentSensor:sensor @1

            SeismologicalAntenna:antenna @2
            SeismologicalAntennaVoltageSensor:sensor @2
            SeismologicalAntennaCurrentSensor:sensor @2
            SeismologicalAntennaFrequencySensor:sensor @2

        }

        GPSObservation:system @1 {
            GPSObservationVent:vent @1
            GPSObservationVentVoltageSensor:sensor @1
            GPSObservationVentCurrentSensor:sensor @1
            GPSObservationVentFlowSensor:sensor @1

            GPSObservationServer:server @0
            BackupGPSObservationServer:server @1 backup(GPSObservationServer) %backup

            GPSObservationServerPowerSensor:sensor @2
            GPSObservationServerTemperatureSensor:sensor @2

            BackupGPSObservationServerPowerSensor:sensor @3
            BackupGPSObservationServerTemperatureSensor:sensor @3

            GPSObservationController:controller @1
MainController:GPSObservationController[signal]@signal_controller
GPSObservationController:GPSObservationControllerVoltageSensor[data]@voltage_reading
GPSObservationController:GPSObservationControllerCurrentSensor[data]@current_reading
            GPSObservationControllerVoltageSensor:sensor @1
            GPSObservationControllerCurrentSensor:sensor @1

            GPSObservationAntenna:antenna @2
            GPSObservationAntennaVoltageSensor:sensor @2
            GPSObservationAntennaCurrentSensor:sensor @2
            GPSObservationAntennaFrequencySensor:sensor @2

        }

        MeteorologicalObservation:system @2 {

            MeteorologicalTemperatureSensor:sensor @0 external@weather.temperature
            MeteorologicalPressureSensor:sensor @1 external@weather.pressure
            MeteorologicalWindSpeedSensor:sensor @2 external@weather.wind_speed
            MeteorologicalHumiditySensor:sensor @3 external@weather.humidity

            MeteorologicalObservationAntenna:antenna @5
            MeteorologicalObservationAntennaVoltageSensor:sensor @5
            MeteorologicalObservationAntennaCurrentSensor:sensor @5
            MeteorologicalObservationAntennaFrequencySensor:sensor @5

        }
    }


    /*
    * STATION-WIDE ENVIRONMENT / STATUS
    */

    StationEnvironmentalMonitoring:system @12 %station_monitoring {

        MaitriStationTemperatureSensor:sensor @0
        MaitriStationPersonnelCountSensor:sensor @1

        MaitriStationEnvironmentalAntenna:antenna @2
        MaitriStationEnvironmentalAntennaVoltageSensor:sensor @2
        MaitriStationEnvironmentalAntennaCurrentSensor:sensor @2
        MaitriStationEnvironmentalAntennaFrequencySensor:sensor @2

    }


    /*
    * STATION-WIDE EMERGENCY SUPPORT
    */

    EmergencySupport:block @13 %emergency {
        EmergencySupportTemperatureSensor:sensor @1
        EmergencySupportAntenna:antenna @1
        EmergencySupportAntennaVoltageSensor:sensor @1
        EmergencySupportAntennaCurrentSensor:sensor @1
        EmergencySupportAntennaFrequencySensor:sensor @1

        EmergencyStorage:storage @0
        EmergencyStorageWeightSensor:sensor @0
        EmergencyStorageCountSensor:sensor @0

        EmergencyVehicle:vehicle @1

        EmergencyCommunicationAntenna:antenna @2
        EmergencyCommunicationAntennaVoltageSensor:sensor @2
        EmergencyCommunicationAntennaCurrentSensor:sensor @2
        EmergencyCommunicationAntennaFrequencySensor:sensor @2

        BackupEmergencyCommunicationAntenna:antenna @3 backup(EmergencyCommunicationAntenna) %backup
        BackupEmergencyCommunicationAntennaVoltageSensor:sensor @3
        BackupEmergencyCommunicationAntennaCurrentSensor:sensor @3
        BackupEmergencyCommunicationAntennaFrequencySensor:sensor @3


        EmergencyAlarm:alarm @0
        BackupEmergencyAlarm:alarm @1 backup(EmergencyAlarm) %backup

        EmergencyAlarmVoltageSensor:sensor @1
        EmergencyAlarmCurrentSensor:sensor @1
        BackupEmergencyAlarmVoltageSensor:sensor @1
        BackupEmergencyAlarmCurrentSensor:sensor @1

        EmergencyController:controller @2
MainController:EmergencyController[signal]@signal_controller
EmergencyController:EmergencyControllerVoltageSensor[data]@voltage_reading
EmergencyController:EmergencyControllerCurrentSensor[data]@current_reading
        EmergencyControllerVoltageSensor:sensor @2
        EmergencyControllerCurrentSensor:sensor @2

    }

}