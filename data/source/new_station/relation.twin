Campus:campus {
    StationA:station {
        BlockA1:block {
            PowerSystem:system {
                MainGenerator:generator
                PowerSensor:sensor
            }
        }
        BlockA2:block {
            ControlSystem:system {
                MainController:controller
            }
        }
    }

    StationB:station {
        BlockB1:block {
            StorageSystem:system {
                WaterTank:tank
                TankSensor:sensor
            }
        }
        BlockB2:block {
            HVACSystem:system {
                MainPump:pump
            }
        }
    }
}
