# ============================================================

# MAITRI ANTARCTIC RESEARCH STATION

# ============================================================

Maitri:station %critical %essential {
    # --------------------------------------------------------
    # ENERGY BLOCK
    # --------------------------------------------------------

    EnergyBlock:block %critical %essential {

        EnergySystem:system %power %critical {

            Generator1:generator %primary %critical
            Generator2:generator %backup %critical

            BatteryBank:battery %backup %critical
            PowerInverter:inverter %critical

            PowerSensor:sensor %monitoring %critical
            FuelLevelSensor:sensor %monitoring
            BatterySensor:sensor %monitoring

            EnergyController:controller %central %automatic %critical
        }
    }

    # --------------------------------------------------------
    # HVAC BLOCK
    # --------------------------------------------------------

    HVACBlock:block %essential %critical {

        HeatingSystem:system %thermal %essential {

            MainHeater:heater %primary %critical
            BackupHeater:heater %backup %critical

            IndoorTemperatureSensor:sensor %monitoring
            OutdoorTemperatureSensor:sensor %monitoring

            HeatingController:controller %automatic
        }

        VentilationSystem:system %air %essential {

            SupplyFan:fan %primary
            ExhaustFan:fan %backup

            AirQualitySensor:sensor %monitoring %critical
            AirflowSensor:sensor %monitoring

            VentilationController:controller %automatic
        }

        CoolingSubsystem:subsystem %thermal {

            CoolingUnit:cooler %primary

            CoolingTemperatureSensor:sensor %monitoring

            CoolingController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # RESEARCH BLOCK
    # --------------------------------------------------------

    ResearchBlock:block %science {

        ResearchLab:system %laboratory %science {

            WetLab:laboratory %active
            DryLab:laboratory %active

            LabTemperatureSensor:sensor %monitoring
            LabHumiditySensor:sensor %monitoring
            LabGasSensor:sensor %monitoring %critical

            LabController:controller %automatic
        }

        FieldResearchSystem:system %science %mobile {

            SnowVehicle:vehicle %primary %mobile
            ResearchRobot:robot %mobile

            GPS:sensor %monitoring
            WeatherSensor:sensor %monitoring
        }
    }

    # --------------------------------------------------------
    # CONTROL BLOCK
    # --------------------------------------------------------

    ControlBlock:block %central %critical %essential {

        ControlSystem:system %central %critical {

            ControlServer:server %primary %critical
            DataServer:server %backup

            MainController:controller %primary %central %critical
            BackupController:controller %backup %critical

            SystemHealthSensor:sensor %monitoring %critical
            NetworkSensor:sensor %monitoring
        }

        AlarmSystem:subsystem %safety %critical {

            FireAlarm:alarm %critical
            SmokeAlarm:alarm %critical
            EmergencyAlarm:alarm %critical

            AlarmController:controller %automatic %safety
        }
    }

    # --------------------------------------------------------
    # COMMUNICATION BLOCK
    # --------------------------------------------------------

    CommunicationBlock:block %network %essential {

        CommunicationSystem:system %network %critical {

            MainRouter:router %primary %critical
            BackupRouter:router %backup

            SatelliteAntenna:antenna %primary %critical
            RadioAntenna:antenna %backup

            CommunicationServer:server %critical
        }
    }

    # --------------------------------------------------------
    # INVENTORY BLOCK
    # --------------------------------------------------------

    InventoryBlock:block %storage %essential {

        StorageSystem:system %storage {

            FoodStorage:storage %critical
            FuelStorage:storage %critical
            EquipmentStorage:storage

            FoodTemperatureSensor:sensor %monitoring %critical
            FuelLevelSensor2:sensor %monitoring %critical

            InventoryController:controller %automatic
        }

        LogisticsSystem:system %logistics %mobile {

            SupplyVehicle:vehicle %primary %mobile
            CargoVehicle:vehicle %backup %mobile

            LogisticsController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # PERSONNEL BLOCK
    # --------------------------------------------------------

    PersonnelBlock:block %personnel {

        PersonnelSystem:system %administration {

            PersonnelDatabase:database %critical
            PersonnelServer:server %primary

            PersonnelController:controller %automatic

            AccessSensor:sensor %monitoring %security
        }
    }

    # --------------------------------------------------------
    # WATER AND WASTE BLOCK
    # --------------------------------------------------------

    WaterWasteBlock:block %essential %critical {

        WaterSystem:system %water %essential {

            WaterPump:pump %primary %critical
            WaterTank:tank %storage %critical

            WaterLevelSensor:sensor %monitoring %critical
            WaterQualitySensor:sensor %monitoring %critical

            WaterController:controller %automatic
        }

        WasteSystem:system %waste %essential {

            WastePump:pump %primary

            WasteStorage:storage %storage

            WasteLevelSensor:sensor %monitoring

            WasteController:controller %automatic
        }
    }

    # --------------------------------------------------------
    # SAFETY BLOCK
    # --------------------------------------------------------

    SafetyBlock:block %safety %critical %essential {

        FireSafetySystem:system %safety %critical {

            FireSensor:sensor %monitoring %critical
            SmokeSensor:sensor %monitoring %critical

            FireAlarm2:alarm %critical

            FireSafetyController:controller %automatic %safety
        }

        EmergencySystem:system %safety %critical {

            EmergencyBeacon:beacon %critical
            EmergencyRadio:radio %critical

            EmergencySensor:sensor %monitoring %critical

            EmergencyController:controller %automatic %safety
        }
    }
}