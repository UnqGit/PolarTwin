MainBuilding:block {
    dimension {
        width = 40
        length = 20
        height = 10
    }
}
Outpost:block {
    dimension {
        width = 15
        length = 15
        height = 5
    }
}
GroundFloor:floor {
    dimension {
        width = 40
        length = 20
        height = 5
    }
}
FirstFloor:floor {
    dimension {
        width = 40
        length = 20
        height = 5
    }
}
Ground:floor {
    dimension {
        width = 15
        length = 15
        height = 5
    }
}
MainGenerator:generator {
    rating@output {
        power = 500
    }
    rating@state {
        efficiency = 0.85
    }
}
BackupBattery:battery {
    rating@state {
        max_capacity = 1000
    }
}
TransferPump:pump {
    rating@state {
        max_flow = 50
    }
    rating@input {
        power = 5
    }
}
PowerSensor:sensor measures=power {
}
TempSensor:sensor measures=temperature {
}
FuelSensor:sensor measures=fuel {
}
GenEffSensor:sensor measures=efficiency {
}
BattCapSensor:sensor measures=max_capacity {
}
PumpFlowSensor:sensor measures=max_flow {
}
PumpPowSensor:sensor measures=power {
}
GridController:controller {
}
Heater:generic {
}
Radio:antenna {
}
FuelTank:generic {
}
