# -------------------- HVAC ---------------------------------

IndoorTemperatureSensor-->HeatingController@temperature
OutdoorTemperatureSensor-->HeatingController@outside_temperature

HeatingController-->MainHeater@control
HeatingController-->BackupHeater@backup_control

AirQualitySensor-->VentilationController@air_quality
AirflowSensor-->VentilationController@airflow

VentilationController-->SupplyFan@control
VentilationController-->ExhaustFan@control

CoolingTemperatureSensor-->CoolingController@temperature
CoolingController-->CoolingUnit@control

# -------------------- HVAC TO CONTROL ----------------------

HeatingController-->MainController@heating_status
VentilationController-->MainController@ventilation_status
CoolingController-->MainController@cooling_status

MainController-->HeatingController@command
MainController-->VentilationController@command
MainController-->CoolingController@command

